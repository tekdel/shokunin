#!/usr/bin/env bash

WS_PROJECTS=${WS_PROJECTS:-$HOME/projects}
WS_ROOT=${WS_ROOT:-$HOME/work}
WS_GH_TIMEOUT=${WS_GH_TIMEOUT:-60}
WS_PROC=${WS_PROC:-/proc}
WS_TRASH=${WS_TRASH:-${XDG_DATA_HOME:-$HOME/.local/share}/ws/trash}
WS_REGENERABLE=${WS_REGENERABLE-node_modules dist dist-test build coverage prisma-client .next .turbo target __pycache__ .cache}
WS_VAULT=${WS_VAULT:-$HOME/claude-knowledge-vault}
WS_CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/ws
WS_PR_TTL=${WS_PR_TTL:-300}
WS_PR_FAILED_TTL=60
WS_UP_TIMEOUT=${WS_UP_TIMEOUT:-300}
WS_VERIFY_TIMEOUT=${WS_VERIFY_TIMEOUT:-1800}
WS_VERIFY_POLL=${WS_VERIFY_POLL:-5}
WS_JIRA_MCP=${WS_JIRA_MCP:-atlassian}
WS_JIRA_TOOL=${WS_JIRA_TOOL:-getJiraIssue}
WS_GH_JOBS=8

WS_OID_RE='^[0-9a-f]{40}([0-9a-f]{24})?$'
WS_STAMP_RE='[0-9]{8}T[0-9]{6}Z(\.[0-9]+)?'
WS_META_KEYS="orig common branch head ticket pr state oid time"
WS_PROC_PID_INIT_INO=4026531836
WS_NAME_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$'
WS_BRANCH_RE='^[A-Za-z0-9][A-Za-z0-9._/+@-]*$'
WS_KEYS="WS_ID WS_TICKET WS_BRANCH WS_REPOS WS_TOPIC WS_STAGE WS_SCENARIOS_SHA256 WS_SLOT WS_URLS WS_CREATED"
WS_STAGES="spec planned building verifying qa review merged"
WS_OPERATOR_STAGES="planned qa review"
WS_BUILDING_LIMIT=5
WS_ENV_START='<!-- ws env: ws up and ws down rewrite the lines up to the end marker -->'
WS_ENV_END='<!-- /ws env -->'

declare -gA WS_COMMANDS=(
    [adopt]="move existing worktrees of one branch into a ticket"
    [done]="set a ticket to merged, run vault-consolidate, and offer ws rm"
    [down]="stop the dockyard env of a ticket and keep its slot"
    [ls]="list the tickets"
    [new]="make or repair a ticket: worktrees, .ws, CLAUDE.md, and a tmux session"
    [pick]="pick a ticket, a project, or the vault and switch to its tmux session"
    [prune]="list worktrees whose PR merged or closed, --apply moves them to the trash"
    [rm]="stop a ticket's sessions and env and move its worktrees to the trash"
    [scenarios]="write the holdout scenarios of a ticket from its Jira issue or a file"
    [stage]="set the stage of a ticket"
    [status]="refresh the status cache, or print how many sessions wait on you"
    [up]="start the dockyard env of a ticket and record its slot and URLs"
    [verify]="run the holdout scenarios of a ticket against its env in a background Claude session"
)
declare -gA T_STAGE=() T_BRANCH=() T_REPOS=() T_ENV=() T_BAD=() P_STATES=()
declare -ga T_IDS=() T_PLAIN=() S_CWD=() S_WAIT=() R_PATH=() R_TEXT=()
declare -gA WS_TICKET_TRASH=()
declare -ga WS_MOUNT_NAMES=() WS_MOUNT_SOURCES=()
declare -ga WS_WT_REPOS=() WS_WT_PATHS=() WS_WT_UNREAD=() WS_HITS=() WS_SCANNED_REPOS=() WS_CWD_PIDS=()
declare -ga TICKET_OLD=() TICKET_REPOS=() TICKET_ADD=()
WS_ENGINE_ERR="ws did not ask the container engines"
WS_ENGINES_OK=
WS_MOVED_TO=
WS_TMUX_PIDS=" "

# shellcheck disable=SC2016
WS_MOUNTS_JQ='
    .[] | (.Name | if type == "string" then ltrimstr("/") else error("a container has no name") end) as $name
    | if ($name | contains("\u0000")) then error("a container name holds a NUL byte") else . end
    | ((.Mounts // []) | if type == "array" then .[] else error("container \($name): Mounts is not a list") end
        | select((.Type | if type == "string" then ascii_downcase
            else error("container \($name): a mount has no type") end) == "bind")
        | .Source),
      ((.HostConfig.Binds // []) | if type == "array" then .[] else error("container \($name): Binds is not a list") end
        | if type == "string" then split(":")[0] else error("container \($name): a bind is not a string") end
        | select(test("^[A-Za-z0-9][A-Za-z0-9_.-]*$") | not))
    | if type == "string" and startswith("/") and (contains("\u0000") | not)
      then "\($engine) container \($name)\u0000\(.)\u0000"
      else error("container \($name): a bind mount source that is not an absolute path: \(tojson)") end'

usage() {
    local cmd
    echo "usage: ws <command> [args]"
    echo
    for cmd in $(printf '%s\n' "${!WS_COMMANDS[@]}" | sort); do
        printf '  %-10s %s\n' "$cmd" "${WS_COMMANDS[$cmd]}"
    done
}

prune_usage() {
    cat <<'EOF'
usage: ws prune [--apply] [--include-detached]
       ws prune --restore <name|path>
       ws prune --purge [--older-than <days>d]

Lists every linked worktree under $WS_PROJECTS/ and $WS_ROOT/<ticket>/
as REMOVE or KEEP. A worktree is REMOVE only when no KEEP reason below
applies. A KEEP row shows the first reason that applies.

  --apply             ask once, check each worktree again, and move the
                      unchanged ones that no other repo lists to the
                      trash; branches stay
  --include-detached  also check detached worktrees, which have no PR
  --restore <name>    move a trashed worktree, or a whole ticket, back
                      to where it was; name is the worktree, the ticket,
                      the trash entry, or one of their paths
  --purge             check each trash entry older than --older-than
                      (default 14d) again, ask once, then delete the
                      ones that still pass and their merged branches;
                      commits that only their reflogs hold go to a
                      bundle, and ticket files go to the archive

KEEP reasons:
  unreadable      a git command, file, record, or process could not be
                  read
  no-github       origin is missing or not on github.com
  detached        HEAD is detached and --include-detached is not set
  open            the branch has an open PR
  no-pr           the branch has no PR from its own repo
  locked          git worktree lock is set, with or without a reason
  submodules      the worktree has submodules
  dirty           a file is changed or untracked
  hidden-flags    a file is marked skip-worktree or assume-unchanged
  odd-name        a file name holds a tab or a newline, or the worktree
                  path holds a carriage return
  nested-repo     a .git, .hg, .jj, .svn, .bzr, _darcs, .sl, .pijul,
                  .fslckout, _FOSSIL_, or bare repository sits inside it
  ignored-unique  an ignored file has no byte-identical copy in the main
                  checkout; files under a top-most ignored directory
                  whose name matches WS_REGENERABLE are not compared
  in-use          a process has its working directory inside it
  unpushed        no remote has a commit of HEAD, refs/worktree/*, or
                  refs/bisect/*, and HEAD is not the merged PR's head
  head-not-in-pr  HEAD is not the PR's head commit or an ancestor of it
  cross-fs        the trash is on another filesystem

The in-use check reads the working directory of every process in /proc,
and asks docker and podman, when they are on PATH, for the bind mounts of
each running container. It runs at the scan, again before --apply moves a
worktree, and again before --purge deletes an entry.

A process in another mount namespace counts when its directory is the
worktree or a directory up to three levels below it, outside
WS_REGENERABLE directories. A process of yours whose directory or status
file ws cannot read, because it turned off core dumps or holds extra
capabilities, makes every worktree KEEP unreadable while it runs, and so
does a zombie process of yours until its parent reaps it; the row names
the zombie's parent. The check skips such a process when its parent
belongs to another user, as for SSH logins, when its parent is a process
of yours whose own parent is init, as for user services and daemons such
as a tmux server, and when it runs below a containerd-shim in docker's
containerd namespace, moby, while docker answered, or below a conmon
while podman answered, since the container check covers it. So a command
that turns off core dumps and runs directly in a tmux pane is not seen.
The check does not see processes of other users either. It does not look
at open files. A process whose directory is elsewhere can hold an ignored
file in a worktree open, and a write it makes in the about 45 ms between
the last check of --purge and the removal is lost. --purge asks the
engines about 85 ms before the removal, so a container that starts in
that window is not seen. Both windows grow when --purge saves a bundle
first.

A worktree that is the source of a container's bind mount, holds one, or
lies inside one is KEEP in-use, and the row names the container. ws
reads Mounts and HostConfig.Binds, and --purge also matches the path an
entry came from. An engine whose daemon does not run has no containers,
unless a containerd-shim, conmon, crun, runc, or runsc process runs, as
with docker live-restore: then every worktree is KEEP unreadable. Any
other engine error, an engine that does not answer in 30 s, an inspect
that leaves out a container ps listed, and a bind mount whose source is
not an absolute path make every worktree KEEP unreadable. The check does
not see named volumes, containers of another docker context or of
another engine, or a container whose mount source was moved or renamed
after it started.

The trash:
  <stamp>-<name>/        a worktree; <stamp>-<name>.meta is its record
  <stamp>-<ticket>/      the worktrees, records, and files of one ticket
  archive/               bundles and ticket files that --purge took out
When a name is taken, its stamp gets a counter, as in <stamp>.2-<name>.
A trash directory without a record is an orphan. --restore and --purge
never delete one. They list each orphan, each entry git cannot use,
each record whose directory is gone, and each directory that holds no
record, with what ws knows. To learn where git has a worktree, ws asks
every repo directly under WS_PROJECTS, the repo of every record, at
--apply, the repo of every worktree it scanned, and, for a ticket dir,
the repo of every .git inside it; a git worktree list that fails or
takes more than 10 s makes ws keep everything it would decide. --apply
skips a worktree that another repo lists too, as after a reclone. A
note prints a git worktree move, out of the trash to where the entry
came from or a free path next to it, only when exactly one repo lists
the entry, the entry's .git is a file that names that repo's own record
of it, and no repo lists a worktree inside it. No note prints git
worktree repair. rmdir removes a directory that holds only empty
directories. A record whose directory is gone is deleted when git lists
its worktree out of the trash, at the path it came from, or, for a .meta
record, when no repo lists its worktree at a path ws used; it stays
while any repo lists a worktree in the trash at its path. Everything
else stays, and the note says why. When you repair an entry from a repo
that moved, ws writes that repo into its record.

Ticket files are what is left in a ticket dir once its worktrees move.
--apply moves them to the trash after its last move, and --purge moves
them to the archive, only while the dir holds no .git at any depth, no
repo lists a worktree in it, no process works in it, and no container
mounts it. --apply, --restore, and --purge remove a temp dir that a ws
run left in the trash once that run is gone; ws keeps the temp dirs of a
run in another pid namespace, since it cannot see whether that run is
gone. Older ws runs named their temp dirs .tmp.<pid>.XXXXXX or
.tmp.XXXXXX. ws removes the first kind only when it runs in the host's
pid namespace and no process has that pid, and never removes the second
kind, whose name holds no pid. It lists each one it keeps with its path.

Known limits:
  ws takes no lock, so two ws prune runs at the same time can act on
  the same entries. Run one at a time.
  A worktree, clone, or file that appears in a ticket dir after --apply
  checks the dir moves to the trash with the ticket files.

Environment:
  WS_TRASH        the trash, ${XDG_DATA_HOME:-~/.local/share}/ws/trash by
                  default; it must not be your home or a directory above
                  it, and must not lie inside WS_ROOT or WS_PROJECTS
  WS_REGENERABLE  names or glob patterns of ignored directories whose
                  files are not compared, default "node_modules dist
                  dist-test build coverage prisma-client .next .turbo
                  target __pycache__ .cache"
  WS_GH_TIMEOUT   seconds before a gh call fails, 60 by default
EOF
}

ws_record() {
    local sep="" v
    while (($# >= 2)); do
        v=${2//"%"/%25}
        v=${v//$'\t'/%09}
        v=${v//$'\n'/%0A}
        printf '%s%s=%s' "$sep" "$1" "${v//$'\r'/%0D}"
        sep=$'\t'
        shift 2
    done
    printf '\n'
}

ws_decode() {
    local v=${1//"%09"/$'\t'}
    v=${v//"%0A"/$'\n'}
    v=${v//"%0D"/$'\r'}
    printf '%s' "${v//"%25"/%}"
}

ws_detail() {
    local v
    v=$(ws_decode "$1" && echo .)
    v=${v%.}
    if [[ $v == *[$'\t\n\r']* ]]; then
        printf '%q\n' "$v"
    else
        printf '%s\n' "$v"
    fi
}

ws_get() {
    local field
    local -a fields=()
    IFS=$'\t' read -r -a fields <<<"$1"
    for field in "${fields[@]}"; do
        if [[ ${field%%=*} == "$2" && $field == *=* ]]; then
            printf '%s\n' "${field#*=}"
            return 0
        fi
    done
    return 1
}

ws_fact() {
    awk -v key="$2" 'index($0, key "=") == 1 { print substr($0, length(key) + 2); found = 1; exit }
        END { exit !found }' "$1"
}

ws_shown() {
    local p=${1/#"$HOME/"/\~/}
    [[ $1 != "$HOME" ]] || p='~'
    if [[ $p == *[$'\t\n\r']* ]]; then
        printf '%q\n' "$p"
    else
        printf '%s\n' "$p"
    fi
}

# Prints each linked worktree directly inside the given roots, one path
# per line. Symlinks are skipped, and a worktree reached through two
# roots prints once.
ws_worktrees() {
    local root dir real
    local -A seen=()
    for root in "$@"; do
        while IFS= read -r -d '' dir; do
            [[ -f $dir/.git ]] || continue
            if [[ $dir == *[$'\t\n']* ]]; then
                echo "ws: skip $dir: tab or newline in the path" >&2
                continue
            fi
            real=$(realpath -e -- "$dir") || continue
            [[ -z ${seen[$real]+set} ]] || continue
            seen[$real]=1
            printf '%s\n' "$dir"
        done < <(find -H "$root" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)
    done
}

ws_github_slug() {
    local url host path
    url=$(git --git-dir="$1" config --get remote.origin.url) || return
    if [[ $url =~ ^[a-z+]+://([^@/]+@)?([^/:]+)(:[0-9]+)?/(.+)$ ]]; then
        host=${BASH_REMATCH[2]} path=${BASH_REMATCH[4]}
    elif [[ $url =~ ^([^@/]+@)?([^/:]+):(.+)$ ]]; then
        host=${BASH_REMATCH[2]} path=${BASH_REMATCH[3]}
    else
        return 1
    fi
    [[ $host == github.com || $host == github.com-* ]] || return 1
    path=${path%/}
    path=${path%.git}
    [[ $path =~ ^[^/]+/[^/]+$ ]] || return 1
    echo "$path"
}

ws_main_checkout() {
    local -a fields=()
    mapfile -d '' fields < <(timeout -k 5 10 git --git-dir="$1" worktree list --porcelain -z)
    wait $! || return 1
    [[ ${fields[0]-} == "worktree "* ]] || return 1
    if [[ ${fields[1]-} != bare ]]; then
        printf '%s\n' "${fields[0]#worktree }"
    fi
}

ws_ppid() {
    local stat
    { read -r stat <"$WS_PROC/$1/stat"; } 2>/dev/null || return 1
    stat=${stat##*) }
    stat=${stat#* }
    printf '%s\n' "${stat%% *}"
}

ws_system_child() {
    local parent
    parent=$(ws_ppid "$1") || return 1
    [[ -d $WS_PROC/$parent ]] || return 1
    [[ ! -O $WS_PROC/$parent ]] || [[ $(ws_ppid "$parent") == 1 ]]
}

ws_comm() {
    local stat
    { IFS= read -r stat <"$WS_PROC/$1/stat"; } 2>/dev/null || return 1
    stat=${stat#*(}
    printf '%s\n' "${stat%)*}"
}

# Docker runs its containers in the containerd namespace moby; k3s and
# other containerd clients use their own. The shim's flag parser keeps
# the last -namespace it is given.
ws_shim_namespace() {
    local arg prev="" ns="" set=0
    local -a args=()
    [[ -r $WS_PROC/$1/cmdline ]] || return 1
    mapfile -d '' args <"$WS_PROC/$1/cmdline"
    for arg in "${args[@]}"; do
        if [[ $prev == -namespace || $prev == --namespace ]]; then
            ns=$arg set=1
        elif [[ $arg == -namespace=* || $arg == --namespace=* ]]; then
            ns=${arg#*=} set=1
        fi
        prev=$arg
    done
    ((set)) && [[ $ns == "$2" ]]
}

ws_engine_vouches() {
    local pid=$1 stat comm i
    for ((i = 0; i < 64; i++)); do
        { IFS= read -r stat <"$WS_PROC/$pid/stat"; } 2>/dev/null || return 1
        comm=${stat#*(}
        comm=${comm%)*}
        case $comm in
        containerd-shim*)
            [[ " $WS_ENGINES_OK " == *" docker "* ]] && ws_shim_namespace "$pid" moby
            return
            ;;
        conmon)
            [[ " $WS_ENGINES_OK " == *" podman "* ]]
            return
            ;;
        esac
        pid=${stat##*) }
        pid=${pid#* }
        pid=${pid%% *}
        [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1)) || return 1
    done
    return 1
}

ws_runtime() {
    local f stat comm
    for f in "$WS_PROC"/[0-9]*/stat; do
        { IFS= read -r stat <"$f"; } 2>/dev/null || continue
        comm=${stat#*(}
        comm=${comm%)*}
        case $comm in
        containerd-shim* | conmon* | crun | runc* | runsc*)
            printf '%s (%s)\n' "${stat%% *}" "$comm"
            return 0
            ;;
        esac
    done
    return 1
}

ws_name_args() {
    local name
    for name; do
        printf -- '-o\0-name\0%s\0' "$name"
    done
}

ws_dir_ids() {
    local -a names=() skip=()
    read -r -a names <<<"$WS_REGENERABLE"
    mapfile -d '' skip < <(ws_name_args "${names[@]}")
    stat -c '%d:%i' -- "$1"
    ((${#skip[@]} == 0)) || skip=(-type d \( "${skip[@]:1}" \) -prune -o)
    find "$1" -mindepth 1 -maxdepth 3 "${skip[@]}" -type d -printf '%D:%i\n' 2>/dev/null
}

# A tmux server or client holds its working directory but runs nothing
# there, and the server is the parent of every pane, so ws ignores only
# the exact pids of WS_TMUX_PIDS, never their children.
ws_owned() {
    local exempt=$1 pid=$2 i
    [[ $WS_TMUX_PIDS != *" $pid "* ]] || return 0
    [[ $exempt == *[0-9]* ]] || return 1
    for ((i = 0; i < 64; i++)); do
        [[ $exempt != *" $pid "* ]] || return 0
        pid=$(ws_ppid "$pid") || return 1
        [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1)) || return 1
    done
    return 1
}

ws_cwd_count() {
    local real self proc link name state ppid parent id ids="" n=0 rc=0 out exempt=" ${*:2} "
    local -a status=()
    local -A cwd=() foreign=()
    WS_CWD_PIDS=()
    real=$(realpath -e -- "$1") || return 1
    self=$(readlink -- "$WS_PROC/self/ns/mnt" 2>/dev/null) || self=
    while IFS=$'\t' read -r -d '' proc link; do
        [[ -n $link ]] || continue
        if [[ $proc == */ns/mnt ]]; then
            [[ $link == "$self" ]] || foreign[${proc%/ns/mnt}]=1
        else
            cwd[${proc%/cwd}]=$link
        fi
    done < <(find "$WS_PROC"/[0-9]*/cwd "$WS_PROC"/[0-9]*/ns/mnt -maxdepth 0 -printf '%p\t%l\0' 2>/dev/null)
    wait $! || rc=$?
    # find exits 1 on any file it cannot read, such as a process that exits during the scan.
    if ((rc > 1)); then
        echo "cannot list working directories: find exited $rc"
        return 1
    fi
    for proc in "${!cwd[@]}"; do
        link=${cwd[$proc]}
        if [[ $link == "$real" || $link == "$real"/* ]]; then
            :
        elif [[ -n ${foreign[$proc]+set} ]] && id=$(stat -L -c '%d:%i' -- "$proc/cwd" 2>/dev/null); then
            [[ -n $ids ]] || ids=$'\n'$(ws_dir_ids "$real")$'\n'
            [[ $ids == *$'\n'"$id"$'\n'* ]] || continue
        else
            continue
        fi
        ws_owned "$exempt" "${proc##*/}" || WS_CWD_PIDS+=("${proc##*/}")
    done
    n=${#WS_CWD_PIDS[@]}
    # Under unshare -r our uid reads as 0, and our processes outside the
    # namespace have working directories ws cannot read.
    ((EUID != 0)) || {
        echo "$n"
        return 0
    }
    # awk stops at a file argument it cannot open; getline skips only that file.
    status=("$WS_PROC"/[0-9]*/status)
    out=$(printf '%s\n' "${status[@]}" | awk -v me="$EUID" '
        {
            dir = $0
            sub("/status$", "", dir)
            name = ""
            state = ppid = "-"
            while ((r = (getline line < $0)) > 0) {
                if (line ~ /^Name:/) {
                    name = line
                    sub(/^Name:[ \t]*/, "", name)
                } else if (line ~ /^State:/) {
                    split(line, f)
                    state = f[2]
                } else if (line ~ /^PPid:/) {
                    split(line, f)
                    ppid = f[2]
                } else if (line ~ /^Uid:/) {
                    split(line, uid)
                    if (uid[2] == me && uid[3] == me)
                        print dir "\t" state "\t" ppid "\t" name
                    break
                }
            }
            if (r < 0)
                print dir "\t?\t-\t"
            close($0)
        }
        END { print "end\t" NR }') || {
        echo "cannot read process status files: awk failed"
        return 1
    }
    if [[ ${out##*$'\n'} != "end"$'\t'"${#status[@]}" ]]; then
        echo "cannot read process status files: awk did not finish"
        return 1
    fi
    while IFS=$'\t' read -r proc state ppid name; do
        [[ $proc == "$WS_PROC"/* && -z ${cwd[$proc]+set} ]] || continue
        if [[ $state == "?" ]]; then
            [[ -O $proc ]] || continue
            name=$(ws_comm "${proc##*/}") || name=
        fi
        if link=$(readlink -- "$proc/cwd" 2>/dev/null); then
            if [[ $link == "$real" || $link == "$real"/* ]] && ! ws_owned "$exempt" "${proc##*/}"; then
                WS_CWD_PIDS+=("${proc##*/}")
                n=$((n + 1))
            fi
        elif [[ -e $proc ]] && ! ws_system_child "${proc##*/}" && ! ws_engine_vouches "${proc##*/}"; then
            if [[ $state == Z ]]; then
                parent=$(ws_comm "$ppid") || parent="parent gone"
                echo "process ${proc##*/} ($name) is a zombie child of process $ppid ($parent)"
            else
                echo "process ${proc##*/} ($name) hides its working directory"
            fi
            return 1
        fi
    done <<<"$out"
    echo "$n"
}

ws_engine_down() {
    ((0 < $2 && $2 < 124)) && [[ -s $1 ]] &&
        ! grep -qvE 'Cannot connect to the Docker daemon|Cannot connect to Podman|connect: (no such file or directory|connection refused)' \
            -- "$1"
}

ws_usec() {
    printf '%s\n' "${EPOCHREALTIME//[!0-9]/}"
}

ws_engine_failed() {
    local line
    if (($2 == 124 || $2 == 137)) && (($(ws_usec) - $4 >= 30000000)); then
        printf '%s timed out after 30 s\n' "$1"
        return
    fi
    line=$(head -n 1 -- "$3")
    printf '%s failed: %s\n' "$1" "${line:-exit code $2}"
}

# inspect exits 1 with "no such object" for a container that stopped after ps.
ws_engine_answered() {
    local engine=$1 err=$2 json=$3 rc=$4 line id
    local -A seen=()
    shift 4
    if ((rc)) && [[ ! -s $err ]]; then
        printf '%s inspect failed: exit code %s\n' "$engine" "$rc"
        return 1
    fi
    if ((rc)); then
        while IFS= read -r line || [[ -n $line ]]; do
            if ! [[ $line =~ [Nn]o\ such\ (object|container):\ *\"?([^\"]+)\"?$ ]]; then
                printf '%s inspect failed: %s\n' "$engine" "$line"
                return 1
            fi
            seen[${BASH_REMATCH[2]}]=1
        done <"$err"
    fi
    while IFS= read -r id; do
        seen[$id]=1
    done < <(jq -r '.[].Id | strings' <"$json" 2>/dev/null)
    for id; do
        if [[ -z ${seen[$id]+set} ]]; then
            printf '%s inspect did not answer for container %s\n' "$engine" "$id"
            return 1
        fi
    done
}

ws_engine_mounts() {
    local engine tmp rc i start runtime
    local -a ids=() found=()
    WS_MOUNT_NAMES=()
    WS_MOUNT_SOURCES=()
    WS_ENGINES_OK=
    WS_ENGINE_ERR=
    tmp=$(mktemp -d) || {
        WS_ENGINE_ERR="cannot make a temp dir to ask the container engines"
        return 0
    }
    for engine in docker podman; do
        type -P "$engine" >/dev/null || continue
        start=$(ws_usec)
        mapfile -t ids < <(timeout -k 5 30 "$engine" ps -q --no-trunc 2>"$tmp/err" </dev/null)
        wait $! && rc=0 || rc=$?
        if ws_engine_down "$tmp/err" "$rc"; then
            if runtime=$(ws_runtime); then
                WS_ENGINE_ERR="the $engine daemon is down, but containers may still run: process $runtime"
                break
            fi
            continue
        elif ((rc)); then
            WS_ENGINE_ERR=$(ws_engine_failed "$engine ps" "$rc" "$tmp/err" "$start")
            break
        fi
        if ((${#ids[@]})); then
            start=$(ws_usec) rc=0
            # Keeps bash from printing a notice when timeout kills inspect.
            { timeout -k 5 30 "$engine" inspect "${ids[@]}" >"$tmp/json" 2>"$tmp/err" </dev/null || rc=$?; } 2>/dev/null
            if ((rc >= 124)); then
                WS_ENGINE_ERR=$(ws_engine_failed "$engine inspect" "$rc" "$tmp/err" "$start")
                break
            fi
            if ! WS_ENGINE_ERR=$(ws_engine_answered "$engine" "$tmp/err" "$tmp/json" "$rc" "${ids[@]}"); then
                break
            fi
            mapfile -d '' found < <(jq -j --arg engine "$engine" "$WS_MOUNTS_JQ" <"$tmp/json" 2>"$tmp/err")
            if ! wait $! || ((${#found[@]} % 2)); then
                WS_ENGINE_ERR=$(ws_engine_failed "reading $engine inspect" 1 "$tmp/err" "$start")
                break
            fi
            for ((i = 0; i < ${#found[@]}; i += 2)); do
                WS_MOUNT_NAMES+=("${found[i]}")
                WS_MOUNT_SOURCES+=("$(realpath -m -- "${found[i + 1]}")")
            done
        fi
        WS_ENGINES_OK+=" $engine"
    done
    rm -rf -- "$tmp"
}

ws_container_facts() {
    local path real i
    local -a reals=()
    local -A seen=()
    if [[ -n $WS_ENGINE_ERR ]]; then
        ws_record unreadable "$WS_ENGINE_ERR"
        return 0
    fi
    ((${#WS_MOUNT_SOURCES[@]})) || return 0
    for path; do
        reals+=("$(realpath -m -- "$path")")
    done
    for i in "${!WS_MOUNT_SOURCES[@]}"; do
        for real in "${reals[@]}"; do
            if ws_within "${WS_MOUNT_SOURCES[i]}" "$real" || ws_within "$real" "${WS_MOUNT_SOURCES[i]}"; then
                [[ -n ${seen[${WS_MOUNT_NAMES[i]}]+set} ]] || ws_record container "${WS_MOUNT_NAMES[i]}"
                seen[${WS_MOUNT_NAMES[i]}]=1
                break
            fi
        done
    done
}

ws_regenerable() {
    local name
    local -a names=()
    read -r -a names <<<"$WS_REGENERABLE"
    for name in "${names[@]}"; do
        # shellcheck disable=SC2053
        [[ $1 != $name ]] || return 0
    done
    return 1
}

ws_ignored_copy() {
    local w=$1/$4 m=$3/$4 real wl ml rc=0
    [[ -n $3 ]] || return 1
    if [[ -L $w ]]; then
        [[ -L $m ]] || return 1
        wl=$(readlink -- "$w") && ml=$(readlink -- "$m") || return 2
        [[ $wl == "$ml" ]]
        return
    fi
    [[ -f $w && -f $m ]] || return 1
    real=$(realpath -e -- "$m") || return 1
    [[ $real != "$2" && $real != "$2"/* && ! $w -ef $m ]] || return 1
    cmp -s -- "$w" "$m" || rc=$?
    case $rc in
    0 | 1) return "$rc" ;;
    *) return 2 ;;
    esac
}

ws_content_facts() {
    local dir=$1 main=$2 realdir entry rel mark name rc
    local -a entries=() marks=() files=() repo=()
    local -A checked=()
    realdir=$(realpath -e -- "$dir") || {
        ws_record unreadable "cannot resolve $dir"
        return 0
    }

    mapfile -d '' repo < <(ws_name_args .git .hg .jj .svn .bzr _darcs .sl .pijul .fslckout _FOSSIL_)
    mapfile -d '' marks < <(find "$dir" -mindepth 1 \
        \( -name $'*\t*' -o -name $'*\n*' \) -printf 'odd\t%P\0' , \
        \( "${repo[@]:1}" \) -printf 'repo\t%P\0' -prune , \
        -name HEAD -type f -printf 'head\t%P\0' 2>/dev/null | sort -z)
    wait $! || ws_record unreadable "cannot read every directory in the worktree"
    for mark in "${marks[@]}"; do
        rel=${mark#*$'\t'}
        case ${mark%%$'\t'*} in
        odd) ws_record odd-name "$rel" ;;
        repo)
            if [[ $rel == */* ]]; then
                ws_record nested-repo "${rel%/*}"
            elif [[ $rel != .git ]]; then
                ws_record nested-repo .
            fi
            ;;
        head)
            [[ $rel == */HEAD ]] && rel=${rel%/HEAD} || rel=.
            if [[ -d $dir/$rel/objects && -d $dir/$rel/refs ]]; then
                ws_record nested-repo "$rel"
            fi
            ;;
        esac
    done

    mapfile -d '' entries < <(git -C "$dir" ls-files -z --others --ignored --exclude-standard --directory)
    wait $! || ws_record unreadable "git ls-files --ignored failed"
    for entry in "${entries[@]}"; do
        name=${entry%/}
        if [[ $entry == */ ]]; then
            ! ws_regenerable "${name##*/}" || continue
            mapfile -d '' files < <(find "$dir/$entry" -mindepth 1 \( -type d \( "${repo[@]:1}" \) -prune \) \
                -o \( ! -type d -printf '%P\0' \) 2>/dev/null | sort -z)
            if ! wait $!; then
                ws_record unreadable "cannot read $entry"
                continue
            fi
        elif [[ -L $dir/$entry ]] && ws_regenerable "${name##*/}"; then
            continue
        else
            entry=
            files=("$name")
        fi
        for rel in "${files[@]}"; do
            rel=$entry$rel
            [[ -z ${checked[$rel]+set} ]] || continue
            checked[$rel]=1
            ws_ignored_copy "$dir" "$realdir" "$main" "$rel" && rc=0 || rc=$?
            case $rc in
            0) ;;
            1) ws_record ignored-unique "$rel" ;;
            *) ws_record unreadable "cannot read $rel" ;;
            esac
        done
    done
}

ws_wt_facts() {
    local dir=$1 common gitdir main ref head branch out hidden submodules n rc
    local -a refs=() tips=()
    local -
    set -o pipefail
    ws_record path "$dir"
    [[ $dir != *$'\r'* ]] || ws_record odd-name "a carriage return in the worktree path"
    if ! common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
        ! gitdir=$(git -C "$dir" rev-parse --path-format=absolute --git-dir 2>/dev/null); then
        ws_record unreadable "git cannot open the worktree"
        return 0
    fi
    ws_record common "$common"
    main=$(ws_main_checkout "$common") || {
        main=
        ws_record unreadable "git worktree list failed"
    }
    ws_record main "$main"
    ws_record github "$(ws_github_slug "$common" 2>/dev/null || true)"

    ref=$(git -C "$dir" symbolic-ref -q HEAD) && rc=0 || rc=$?
    branch=
    if ((rc == 0)) && [[ $ref == refs/heads/?* ]]; then
        branch=${ref#refs/heads/}
    elif ((rc != 1)); then
        ws_record unreadable "git cannot read HEAD"
    fi
    ws_record branch "$branch"
    head=$(git -C "$dir" rev-parse -q --verify 'HEAD^{commit}') || {
        head=
        ws_record unreadable "HEAD has no commit"
    }
    ws_record head "$head"

    if [[ -e $gitdir/locked ]]; then
        out=$(cat -- "$gitdir/locked" 2>/dev/null) || {
            out=
            ws_record unreadable "cannot read the lock reason"
        }
        ws_record locked 1
        ws_record lock-reason "$out"
    else
        ws_record locked 0
        ws_record lock-reason ""
    fi

    hidden="" submodules=""
    if out=$(git -C "$dir" ls-files -v -s | awk '$1 ~ /^([a-z]|S)$/ { h++ } $2 == 160000 { s++ } END { print h + 0, s + 0 }'); then
        read -r hidden submodules <<<"$out"
    else
        ws_record unreadable "git ls-files failed"
    fi
    ws_record submodules "$submodules"
    ws_record hidden-flags "$hidden"

    n=$(GIT_OPTIONAL_LOCKS=0 git -C "$dir" -c status.showUntrackedFiles=all status --porcelain=v1 \
        --untracked-files=all --ignore-submodules=none | wc -l) || {
        n=
        ws_record unreadable "git status failed"
    }
    ws_record dirty "$n"

    ws_content_facts "$dir" "$main"

    if out=$(git -C "$dir" for-each-ref --format='%(refname)' refs/worktree refs/bisect); then
        [[ -z $out ]] || mapfile -t refs <<<"$out"
    else
        ws_record unreadable "git for-each-ref failed"
    fi
    for ref in "${refs[@]}"; do
        ws_record wtref "$ref"
    done
    [[ -z $head ]] || tips+=("$head")
    tips+=("${refs[@]}")
    n=0
    if ((${#tips[@]})); then
        n=$(git -C "$dir" rev-list --count "${tips[@]}" --not --remotes) || {
            n=
            ws_record unreadable "git rev-list failed"
        }
    fi
    ws_record unpushed "$n"
    if n=$(ws_cwd_count "$dir"); then
        ws_record in-use "$n"
    else
        ws_record unreadable "${n:-cannot resolve $dir}"
    fi
    ws_container_facts "$@"
    n=$(stat -c %d -- "$dir") || n=
    ws_record dev "$n"
}

ws_verdict() {
    ws_record reason "$1" detail "${2-}"
}

ws_wt_unsafe() {
    local line key k
    local -A f=() count=()
    while IFS= read -r line || [[ -n $line ]]; do
        key=${line%%=*}
        if [[ $line != *=* || ! $key =~ ^[a-z][a-z-]*$ ]]; then
            ws_verdict unreadable "bad fact line"
            return 0
        fi
        key=${key//-/_}
        count[$key]+=x
        case ${#count[$key]} in
        1) f[$key]=${line#*=} ;;
        2 | 3) f[$key]+=", ${line#*=}" ;;
        4) f[$key]+=", ..." ;;
        esac
    done <"$1"

    if [[ -n ${f[unreadable]+set} ]]; then
        printf 'reason=unreadable\tdetail=%s\n' "${f[unreadable]}"
        return 0
    fi
    for k in path common main github branch head locked lock-reason submodules hidden-flags dirty \
        unpushed in-use dev; do
        if [[ ${count[${k//-/_}]-} != x ]]; then
            ws_verdict unreadable "no single $k fact"
            return 0
        fi
    done
    for k in submodules hidden_flags dirty unpushed in_use dev; do
        if ! [[ ${f[$k]} =~ ^[0-9]+$ ]]; then
            ws_verdict unreadable "bad $k fact"
            return 0
        fi
    done
    if ! [[ ${f[locked]} =~ ^[01]$ && ${f[head]} =~ $WS_OID_RE ]]; then
        ws_verdict unreadable "bad locked or head fact"
        return 0
    fi

    if [[ ${f[locked]} == 1 ]]; then
        printf 'reason=locked\tdetail=%s\n' "${f[lock_reason]}"
    elif ! [[ ${f[submodules]} =~ ^0+$ ]]; then
        ws_verdict submodules
    elif ! [[ ${f[dirty]} =~ ^0+$ ]]; then
        ws_verdict dirty
    elif ! [[ ${f[hidden_flags]} =~ ^0+$ ]]; then
        ws_verdict hidden-flags
    elif [[ -n ${f[odd_name]+set} ]]; then
        printf 'reason=odd-name\tdetail=%s\n' "${f[odd_name]}"
    elif [[ -n ${f[nested_repo]+set} ]]; then
        printf 'reason=nested-repo\tdetail=%s\n' "${f[nested_repo]}"
    elif [[ -n ${f[ignored_unique]+set} ]]; then
        printf 'reason=ignored-unique\tdetail=%s\n' "${f[ignored_unique]}"
    elif [[ -n ${f[container]+set} ]]; then
        printf 'reason=in-use\tdetail=%s\n' "${f[container]}"
    elif ! [[ ${f[in_use]} =~ ^0+$ ]]; then
        ws_verdict in-use
    elif ! [[ ${f[unpushed]} =~ ^0+$ ]]; then
        ws_verdict unpushed
    fi
}

prune_pr_facts() {
    local state="" number="" oid="" head path in=no
    if [[ -n $2 ]]; then
        state=$(ws_get "$2" state) || state=
        number=$(ws_get "$2" number) || number=
        oid=$(ws_get "$2" oid) || oid=
    fi
    head=$(ws_fact "$1" head) || head=
    if [[ ($state == merged || $state == closed) && $oid =~ $WS_OID_RE && $head =~ $WS_OID_RE ]]; then
        path=$(ws_decode "$(ws_fact "$1" path)")
        if [[ $head == "$oid" ]] ||
            GIT_NO_LAZY_FETCH=1 git -C "$path" merge-base --is-ancestor "$head" "$oid" 2>/dev/null; then
            in=yes
        fi
    fi
    printf 'pr-state=%s\npr-number=%s\npr-oid=%s\nhead-in-pr=%s\n' "$state" "$number" "$oid" "$in"
}

ws_keep() {
    printf 'action=KEEP\t'
    ws_verdict "$@"
}

prune_classify() {
    local include_detached=$1 trash_dev=$2 facts=$3 pr_facts=$4 unsafe line key
    local -A f=()
    unsafe=$(ws_wt_unsafe "$facts")
    if [[ $unsafe == reason=unreadable$'\t'* ]]; then
        printf 'action=KEEP\t%s\n' "$unsafe"
        return 0
    fi
    while IFS= read -r line; do
        key=${line%%=*}
        if [[ $key =~ ^[a-z][a-z-]*$ ]]; then
            f[${key//-/_}]=${line#*=}
        fi
    done < <(cat -- "$facts" "$pr_facts")

    if [[ -z ${f[github]} ]]; then
        ws_keep no-github
        return 0
    fi
    if [[ -n ${f[branch]} ]]; then
        case ${f[pr_state]-} in
        merged | closed)
            if ! [[ ${f[pr_number]-} =~ ^[0-9]+$ && ${f[pr_oid]-} =~ $WS_OID_RE ]]; then
                ws_keep unreadable "bad PR record"
                return 0
            fi
            ;;
        open | no-pr)
            ws_keep "${f[pr_state]}"
            return 0
            ;;
        *)
            ws_keep unreadable "no usable PR state"
            return 0
            ;;
        esac
    elif [[ $include_detached != 1 ]]; then
        ws_keep detached
        return 0
    fi
    if [[ -n $unsafe ]] && ! [[ $unsafe == reason=unpushed$'\t'* && ${f[pr_state]-} == merged &&
        ${f[head]} == "${f[pr_oid]}" && -z ${f[wtref]+set} ]]; then
        printf 'action=KEEP\t%s\n' "$unsafe"
    elif [[ -n ${f[branch]} && ${f[head_in_pr]-} != yes ]]; then
        ws_keep head-not-in-pr
    elif [[ -n $trash_dev && ${f[dev]} != "$trash_dev" ]]; then
        ws_keep cross-fs
    else
        echo action=REMOVE
    fi
}

ws_gh_list() {
    local out=$1 slug=$2 rc=0
    shift 2
    timeout "$WS_GH_TIMEOUT" gh pr list -R "github.com/$slug" --limit 1000 \
        --json headRefName,headRefOid,isCrossRepository,number,state "$@" >"$out.json" 2>"$out.err" </dev/null ||
        rc=$?
    ((rc != 124)) || echo "gh pr list timed out after ${WS_GH_TIMEOUT}s" >>"$out.err"
    echo "$rc" >"$out.rc"
}

ws_gh_bg() {
    while (($(jobs -pr | wc -l) >= WS_GH_JOBS)); do
        wait -n || true
    done
    ws_gh_list "$@" &
}

ws_pr_pick() {
    jq -rs --argjson files "$#" '
        def enc: gsub("%"; "%25") | gsub("\t"; "%09") | gsub("\n"; "%0A") | gsub("\r"; "%0D");
        def valid: (.number | type) == "number" and .number >= 0 and .number == (.number | floor)
            and (.headRefOid | type) == "string" and (.headRefOid | test("^[0-9a-f]{40}([0-9a-f]{24})?$"))
            and (.state | IN("OPEN", "MERGED", "CLOSED"));
        if length == $files and all(.[]; type == "array") then add else error("gh did not return a PR list") end
        | if all(.[]; type == "object" and (.headRefName | type) == "string") then .
          else error("gh returned a PR without a branch") end
        | map(select(.isCrossRepository == false))
        | group_by(.headRefName)[]
        | if all(.[]; valid) then
            max_by([{OPEN: 3, MERGED: 2, CLOSED: 1}[.state], .number])
            | "branch=\(.headRefName | enc)\tstate=\(.state | ascii_downcase)\tnumber=\(.number)\toid=\(.headRefOid)"
          else "branch=\(.[0].headRefName | enc)\tstate=unknown" end' "$@"
}

ws_pr_failed() {
    echo "ws: cannot read PR state for $(basename "${1%/.git}")" >&2
    sed 's/^/  /' "$2" >&2
}

ws_pr_states() {
    local head_only=0 d line common branch id n=0 failed=0 status
    local -A slug_of=() id_of=() picked=() status_of=()
    [[ ${1-} != --head ]] || head_only=1
    d=$(mktemp -d) || return 2
    cat >"$d/want"

    while IFS= read -r line; do
        common=$(ws_get "$line" common) || continue
        [[ -z ${id_of[$common]+set} ]] || continue
        id_of[$common]=${#id_of[@]}
        slug_of[$common]=$(ws_github_slug "$(ws_decode "$common")" 2>/dev/null) || slug_of[$common]=
        if [[ -z ${slug_of[$common]} ]]; then
            status_of[$common]=no-github
            continue
        fi
        status_of[$common]=ok
        ((head_only)) && continue
        ws_gh_bg "$d/${id_of[$common]}.open" "${slug_of[$common]}" --state open
        ws_gh_bg "$d/${id_of[$common]}.all" "${slug_of[$common]}" --state all
    done <"$d/want"
    wait

    for common in "${!status_of[@]}"; do
        if [[ ${status_of[$common]} != ok ]] || ((head_only)); then
            continue
        fi
        id=$d/${id_of[$common]}
        if [[ $(<"$id.open.rc") == 0 && $(<"$id.all.rc") == 0 ]] &&
            ws_pr_pick "$id.open.json" "$id.all.json" >"$id.picked" 2>>"$id.all.err"; then
            while IFS= read -r line; do
                picked[$common$'\t'$(ws_get "$line" branch)]=$line
            done <"$id.picked"
        else
            cat "$id.open.err" "$id.all.err" >"$id.err"
            ws_pr_failed "$(ws_decode "$common")" "$id.err"
            status_of[$common]=failed
            failed=1
        fi
    done

    while IFS= read -r line; do
        common=$(ws_get "$line" common) || continue
        branch=$(ws_get "$line" branch) || continue
        [[ ${status_of[$common]} == ok && -z ${picked[$common$'\t'$branch]+set} ]] || continue
        n=$((n + 1))
        printf '%s\n' "$line" >"$d/head.$n.key"
        ws_gh_bg "$d/head.$n" "${slug_of[$common]}" --state all --head "$(ws_decode "$branch")"
    done <"$d/want"
    wait

    for ((id = 1; id <= n; id++)); do
        line=$(<"$d/head.$id.key")
        common=$(ws_get "$line" common)
        if [[ $(<"$d/head.$id.rc") == 0 ]] && ws_pr_pick "$d/head.$id.json" >"$d/head.$id.picked" 2>>"$d/head.$id.err"; then
            while IFS= read -r line; do
                picked[$common$'\t'$(ws_get "$line" branch)]=$line
            done <"$d/head.$id.picked"
        else
            ws_pr_failed "$(ws_decode "$common")" "$d/head.$id.err"
            status_of[$common]=failed
            failed=1
        fi
    done

    for common in "${!status_of[@]}"; do
        printf 'repo\tcommon=%s\tstatus=%s\n' "$common" "${status_of[$common]}"
    done
    while IFS= read -r line; do
        common=$(ws_get "$line" common) || continue
        branch=$(ws_get "$line" branch) || continue
        status=${status_of[$common]}
        if [[ $status == ok && -n ${picked[$common$'\t'$branch]+set} ]]; then
            printf 'pr\tcommon=%s\t%s\n' "$common" "${picked[$common$'\t'$branch]}"
        else
            [[ $status != ok ]] || status=no-pr
            printf 'pr\tcommon=%s\tbranch=%s\tstate=%s\n' "$common" "$branch" "$status"
        fi
    done <"$d/want"
    rm -rf "$d"
    ((failed == 0)) || return 2
}

ws_dev_of() {
    local p=$1
    until [[ -e $p ]]; do
        p=$(dirname -- "$p")
    done
    stat -L -c %d -- "$p"
}

ws_within() {
    [[ $2 == / || $1 == "$2" || $1 == "$2"/* ]]
}

ws_env_ok() {
    local p
    if [[ -n ${WS_STAMP-} && ! $WS_STAMP =~ ^[0-9]{8}T[0-9]{6}Z$ ]]; then
        echo "ws: WS_STAMP must look like 20260101T000000Z" >&2
        return 1
    fi
    if [[ ! -d $WS_PROC ]]; then
        echo "ws: WS_PROC $WS_PROC is not a directory" >&2
        return 1
    fi
    if [[ ! -d $WS_PROC/self ]]; then
        echo "ws: WS_PROC $WS_PROC has no self directory, so it is not a process list" >&2
        return 1
    fi
    if [[ $WS_TRASH == *[$'\t\n']* ]]; then
        echo "ws: WS_TRASH must not hold a tab or newline" >&2
        return 1
    fi
    p=$WS_TRASH
    until [[ -e $p || -L $p ]]; do
        p=${p%/*}
        p=${p:-/}
    done
    if [[ -L $p ]]; then
        echo "ws: WS_TRASH $(ws_shown "$WS_TRASH") runs into a symlink loop at $(ws_shown "$p")" >&2
        return 1
    fi
    if ws_within "$(realpath -m -- "$HOME")" "$WS_TRASH"; then
        echo "ws: WS_TRASH $WS_TRASH must not be your home or a directory above it" >&2
        return 1
    fi
    for p in "$WS_ROOT" "$WS_PROJECTS"; do
        p=$(realpath -m -- "$p")
        if ws_within "$WS_TRASH" "$p" || ws_within "$p" "$WS_TRASH"; then
            echo "ws: WS_TRASH $(ws_shown "$WS_TRASH") must not lie inside $(ws_shown "$p") or hold it" >&2
            return 1
        fi
    done
}

ws_free_path() {
    local stem=$1 suffix=${2-} p=$1${2-} k=1
    while [[ -e $p || -L $p || -e $p.meta || -L $p.meta || -e $p.meta.tmp || -L $p.meta.tmp ||
        -e $p.purging || -L $p.purging ]]; do
        k=$((k + 1))
        p=$stem.$k$suffix
    done
    printf '%s\n' "$p"
}

ws_ticket_of() {
    local parent root projects
    parent=$(realpath -e -- "${1%/*}" 2>/dev/null) || return 0
    root=$(realpath -e -- "$WS_ROOT" 2>/dev/null) || return 0
    projects=$(realpath -m -- "$WS_PROJECTS")
    if [[ ${parent%/*} == "$root" && $parent != "$projects" ]]; then
        printf '%s\n' "${1%/*}"
    fi
}

ws_ticket_file() {
    [[ $1 != *.meta && $1 != *.meta.tmp && $1 != *.purging && ! -e $1/.git && ! -L $1/.git ]] &&
        ((${#WS_WT_UNREAD[@]} == 0)) && ! ws_lists_in "$1"
}

ws_holds_entries() {
    local e
    for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
        if [[ ($e == *.meta || $e == *.meta.tmp || $e == *.purging) && (-e $e || -L $e) ]] ||
            [[ -e $e/.git || -L $e/.git ]]; then
            return 0
        fi
    done
    return 1
}

ws_has_record() {
    local e
    for e in "$1"/*.meta "$1"/*.meta.tmp "$1"/.[!.]*.meta "$1"/.[!.]*.meta.tmp; do
        [[ ! -e $e && ! -L $e ]] || return 0
    done
    return 1
}

ws_holds_files() {
    local e
    for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
        [[ ! -e $e && ! -L $e ]] || return 0
    done
    return 1
}

ws_listing_blocker() {
    if ((${#WS_WT_UNREAD[@]})); then
        echo "ws cannot read the worktree list of $(ws_repos_shown "${WS_WT_UNREAD[@]}")"
    elif ws_lists_in "$1"; then
        echo "$(ws_repos_shown "${WS_WT_REPOS[WS_HITS[0]]}") lists a worktree in it, at $(ws_shown "${WS_WT_PATHS[WS_HITS[0]]}")"
    else
        return 1
    fi
}

ws_ticket_blocker() {
    local d=$1 e n line g admin common
    local -a gits=() owners=()
    ws_snapshot_worktrees
    ! ws_listing_blocker "$d" || return 0
    mapfile -d '' gits < <(find "$d" -name .git -prune -print0 2>/dev/null)
    if ! wait $!; then
        echo "ws cannot search it for a .git"
        return 0
    fi
    for g in "${gits[@]}"; do
        if admin=$(ws_gitdir_of "${g%/.git}") &&
            common=$(git --git-dir="$admin" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
            owners+=("$common")
        fi
    done
    if ((${#owners[@]})); then
        ws_snapshot_worktrees "${owners[@]}"
        ! ws_listing_blocker "$d" || return 0
    fi
    if ((${#gits[@]})); then
        g=${gits[0]}
        if [[ -d $g && ! -L $g ]]; then
            echo "it holds a repository at $(ws_shown "${g%/.git}")"
        else
            echo "it holds $(ws_shown "$g"), and no repo ws can ask lists $(ws_shown "${g%/.git}")"
        fi
        return 0
    fi
    for e in "$d"/* "$d"/.[!.]* "$d"/..?*; do
        if [[ ($e == *.meta || $e == *.meta.tmp || $e == *.purging) && (-e $e || -L $e) ]]; then
            echo "it holds $(ws_shown "$e"), which is no ticket file"
            return 0
        fi
    done
    if ! n=$(ws_cwd_count "$d"); then
        echo "${n:-ws cannot resolve it}"
        return 0
    fi
    if ((n)); then
        echo "a process works in it"
        return 0
    fi
    if [[ -n $WS_ENGINE_ERR ]]; then
        echo "$WS_ENGINE_ERR"
        return 0
    fi
    while IFS= read -r line; do
        if [[ $line == container=* ]]; then
            echo "$(ws_detail "${line#container=}") mounts it"
            return 0
        fi
    done < <(ws_container_facts "$d")
    return 1
}

ws_move_entries() {
    local e
    for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
        [[ -e $e || -L $e ]] || continue
        if ! mv -n -- "$e" "$2/" || [[ -e $e || -L $e ]]; then
            return 1
        fi
    done
    rmdir -- "$1" 2>/dev/null
}

ws_meta() {
    while (($# >= 2)); do
        ws_record "$1" "$2"
        shift 2
    done
}

ws_clean_path() {
    [[ $1 == /?* && $1/ != *//* && $1/ != */./* && $1/ != */../* && $1 != *[$'\t\n\r']* ]]
}

ws_meta_read() {
    local file=$1 rel=${1#"$WS_TRASH"/} content line key value
    local -n kv=$2 kv_why=$3
    kv=()
    kv_why=
    rel=${rel%.tmp}
    rel=${rel%.meta}
    if ! [[ $rel =~ ^$WS_STAMP_RE-[^/]+(/[^/]+)?$ ]]; then
        kv_why="a name ws does not make"
    elif [[ -L $file || ! -f $file || ! -r $file ]]; then
        kv_why="not a readable file"
    elif IFS= read -r -d '' content <"$file"; then
        kv_why="a NUL byte"
    elif [[ $content != *$'\n' ]]; then
        kv_why="a cut-off last line"
    fi
    [[ -z $kv_why ]] || return 1
    while IFS= read -r line; do
        key=${line%%=*}
        value=${line#*=}
        if [[ $line != *=* || ! $key =~ ^[a-z]+$ || " $WS_META_KEYS at " != *" $key "* ||
            ${value//"%25"/} == *%* ]]; then
            kv_why="a line ws does not write"
            return 1
        fi
        if [[ -n ${kv[$key]+set} ]]; then
            kv_why="two $key lines"
            return 1
        fi
        kv["$key"]=${value//"%25"/%}
    done <<<"${content%$'\n'}"
    for key in $WS_META_KEYS; do
        if [[ -z ${kv[$key]+set} ]]; then
            kv_why="no $key line"
            return 1
        fi
    done
    if ! ws_clean_path "${kv[orig]}" || ! ws_clean_path "${kv[common]}" ||
        { [[ -n ${kv[at]+set} ]] && ! ws_clean_path "${kv[at]}"; }; then
        kv_why="a bad orig, common, or at"
    elif ! [[ ${kv[head]} =~ $WS_OID_RE ]] || ! [[ -z ${kv[oid]} || ${kv[oid]} =~ $WS_OID_RE ]]; then
        kv_why="a bad head or oid"
    elif ! [[ ${kv[pr]} =~ ^[0-9]*$ && ${kv[state]} =~ ^(merged|closed)?$ && ${kv[time]} =~ ^[1-9][0-9]*$ ]]; then
        kv_why="a bad pr, state, or time"
    elif [[ $rel == */* && (-z ${kv[ticket]} || ${kv[ticket]} != "${kv[orig]%/*}") ]] ||
        [[ $rel != */* && -n ${kv[ticket]} ]]; then
        kv_why="a ticket that is not the dir of orig"
    fi
    [[ -z $kv_why ]]
}

ws_keep_why() {
    local unsafe reason detail
    unsafe=$(ws_wt_unsafe "$1")
    reason=$(ws_get "$unsafe" reason) || return 0
    detail=$(ws_get "$unsafe" detail) || detail=
    printf 'KEEP %s%s\n' "$reason" "${detail:+ ($(ws_detail "$detail"))}"
}

ws_not_purging() {
    [[ -d $1 && ! -L $1 && ! -e $1.purging && ! -L $1.purging ]]
}

ws_record_set() {
    local tmp entry=${4-}
    tmp=$(ws_tmp_dir) || return 1
    if awk -v key="$2=" 'index($0, key) != 1' "$1" >"$tmp/record" && ws_record "$2" "$3" >>"$tmp/record" &&
        [[ -f $1 && ! -L $1 ]] && { [[ -z $entry ]] || ws_not_purging "$entry"; } &&
        mv -T -- "$tmp/record" "$1"; then
        rmdir -- "$tmp" 2>/dev/null || true
        return 0
    fi
    rm -rf -- "$tmp"
    return 1
}

ws_record_at() {
    [[ -n $2 ]] || return 0
    if ws_record_set "$1" at "$2"; then
        echo "ws: its record $(ws_shown "$1") keeps that path" >&2
    fi
}

ws_trash_move() {
    local wt=$1 facts=$2 common branch head ticket dest record why
    shift 2
    ws_engine_mounts
    ws_wt_facts "$wt" >"$facts.now" 2>/dev/null
    if ! cmp -s -- "$facts.now" "$facts"; then
        why=$(ws_keep_why "$facts.now")
        echo "Skipped $(ws_shown "$wt"): ${why:-it changed after the scan}"
        return 1
    fi
    ws_snapshot_worktrees
    if ! why=$(ws_entry_repo "$wt"); then
        echo "Skipped $(ws_shown "$wt"): $why"
        return 1
    fi
    mkdir -p -- "$WS_TRASH" || return 2
    if [[ $(stat -L -c %d -- "$wt") != "$(stat -L -c %d -- "$WS_TRASH")" ]]; then
        echo "Skipped $(ws_shown "$wt"): the trash is on another filesystem"
        return 1
    fi
    : "${WS_STAMP:=$(date -u +%Y%m%dT%H%M%SZ)}"
    common=$(ws_decode "$(ws_fact "$facts" common)")
    branch=$(ws_decode "$(ws_fact "$facts" branch)")
    head=$(ws_fact "$facts" head)
    ticket=$(ws_ticket_of "$wt")
    if [[ -n $ticket && -z ${WS_TICKET_TRASH[$ticket]-} ]]; then
        dest=$(ws_free_path "$WS_TRASH/$WS_STAMP" "-${ticket##*/}")
        mkdir -- "$dest" || return 2
        WS_TICKET_TRASH[$ticket]=$dest
    fi
    if [[ -n $ticket ]]; then
        dest=$(ws_free_path "${WS_TICKET_TRASH[$ticket]}/${wt##*/}")
    else
        dest=$(ws_free_path "$WS_TRASH/$WS_STAMP" "-${wt##*/}")
    fi
    record=$(ws_meta orig "$wt" common "$common" branch "$branch" head "$head" ticket "$ticket" "$@" \
        time "$(date +%s)")
    if ! (set -C && : >"$dest.meta.tmp") 2>/dev/null; then
        echo "ws: cannot make $(ws_shown "$dest.meta.tmp")" >&2
    elif ! printf '%s\n' "$record" >"$dest.meta.tmp"; then
        rm -f -- "$dest.meta.tmp"
        echo "ws: cannot write $(ws_shown "$dest.meta.tmp")" >&2
    elif ! ws_move "$common" "$wt" "$dest"; then
        if ws_landed "$common" "$wt"; then
            rm -f -- "$dest.meta.tmp"
        else
            ws_record_at "$dest.meta.tmp" "$WS_MOVED_TO"
        fi
    elif ! mv -T -- "$dest.meta.tmp" "$dest.meta"; then
        echo "ws: $(ws_shown "$dest") moved, but its record stays in $(ws_shown "$dest.meta.tmp")" >&2
        return 2
    else
        echo "Moved $(ws_shown "$wt") to $(ws_shown "$dest")"
        return 0
    fi
    if [[ -n $ticket ]] && rmdir -- "${dest%/*}" 2>/dev/null; then
        unset 'WS_TICKET_TRASH[$ticket]'
    fi
    return 2
}

prune_summary() {
    local rows=$1 reason line reasons="" removed total n
    total=$(wc -l <"$rows")
    removed=$(awk -F '\t' '$1 == "REMOVE"' "$rows" | wc -l)
    for reason in open no-pr no-github detached unreadable locked submodules dirty hidden-flags odd-name \
        nested-repo ignored-unique in-use unpushed head-not-in-pr cross-fs; do
        n=$(awk -F '\t' -v a="KEEP $reason" '$1 == a' "$rows" | wc -l)
        ((n == 0)) || reasons+="${reasons:+, }$reason $n"
    done
    line="REMOVE $removed  KEEP $((total - removed))"
    [[ -z $reasons ]] || line+=" ($reasons)"
    echo "$line"
}

prune_report() {
    {
        printf 'ACTION\tREPO\tPR\tBRANCH\tWORKTREE\tDETAIL\n'
        cat "$1"
    } | column -t -s $'\t' | sed 's/ *$//'
    echo
    prune_summary "$1"
}

prune_delete_branch() {
    local common=$1 branch=$2 oid=$3 number=$4 out tip
    if out=$(git --git-dir="$common" branch -d "$branch" 2>&1); then
        echo "Deleted branch $branch"
        return
    fi
    tip=$(git --git-dir="$common" rev-parse -q --verify "refs/heads/$branch") || tip=
    if [[ -n $oid && $tip == "$oid" ]] && git --git-dir="$common" branch -D "$branch" >/dev/null 2>&1; then
        echo "Deleted branch $branch, its tip is the head of merged PR #$number"
        return
    fi
    echo "Kept branch $branch: ${out%%$'\n'*}"
}

prune_plan() {
    local d=$1 include_detached=$2 trash_dev=$3 n i dir out common branch verdict action shown number state=- pid
    local -a paths=()
    local -A pr=()
    mkdir -p "$d/facts" "$d/pr"
    mapfile -t paths

    for dir in "${paths[@]}"; do
        out=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir --symbolic-full-name HEAD 2>/dev/null) ||
            continue
        [[ ${out#*$'\n'} != refs/heads/?* ]] || ws_record common "${out%%$'\n'*}" branch "${out#*$'\n'refs/heads/}"
    done | sort -u >"$d/want"
    ws_pr_states <"$d/want" >"$d/prs" &
    pid=$!
    ws_engine_mounts
    n=${#paths[@]}
    for ((i = 0; i < n; i++)); do
        ws_wt_facts "${paths[i]}" >"$d/facts/$i" </dev/null
    done
    wait "$pid" || return
    while IFS= read -r dir; do
        [[ $dir == pr$'\t'* ]] || continue
        pr[$(ws_get "$dir" common)$'\t'$(ws_get "$dir" branch)]=$dir
    done <"$d/prs"

    : >"$d/table"
    : >"$d/plan"
    for ((i = 0; i < n; i++)); do
        common=$(ws_fact "$d/facts/$i" common) || common=
        branch=$(ws_fact "$d/facts/$i" branch) || branch=
        prune_pr_facts "$d/facts/$i" "${pr[$common$'\t'$branch]-}" >"$d/pr/$i"
        verdict=$(prune_classify "$include_detached" "$trash_dev" "$d/facts/$i" "$d/pr/$i")
        action=$(ws_get "$verdict" action)
        [[ $action == REMOVE ]] || action="KEEP $(ws_get "$verdict" reason)"
        shown=$(ws_detail "$(ws_shown "$(ws_fact "$d/facts/$i" path)")")
        number=$(ws_fact "$d/pr/$i" pr-number) || number=
        [[ -z $number ]] || number="#$number $(ws_fact "$d/pr/$i" pr-state)"
        common=${common%/.git}
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$action" "${common##*/}" "${number:-$state}" \
            "${branch:-(detached)}" "$shown" "$(ws_detail "$(ws_get "$verdict" detail || true)")" >>"$d/table"
        [[ $action != REMOVE ]] || echo "$i" >>"$d/plan"
    done
}

ws_confirm() {
    local answer
    printf '%s [y/N] ' "$1"
    read -r answer || echo
    [[ $answer == y || $answer == Y || $answer == yes ]]
}

ws_trash_ticket_files() {
    local ticket=$1 why
    if why=$(ws_ticket_blocker "$ticket"); then
        echo "Kept ticket $(ws_shown "$ticket"): $why"
    elif ws_move_entries "$ticket" "${WS_TICKET_TRASH[$ticket]}"; then
        echo "Moved ticket $(ws_shown "$ticket") with it"
    else
        echo "Kept ticket $(ws_shown "$ticket"): its files could not all move"
    fi
}

prune_apply() {
    local d=$1 n noun=worktrees i status=0 rc path common ticket
    n=$(wc -l <"$d/plan")
    if ((n == 0)); then
        echo "Nothing to move."
        return 0
    fi
    ((n > 1)) || noun=worktree
    if ! ws_confirm "Move $n $noun to the trash?"; then
        echo "Nothing moved."
        return 0
    fi
    WS_SCANNED_REPOS=()
    while IFS= read -r common; do
        WS_SCANNED_REPOS+=("$(ws_decode "$common")")
    done < <(sed -n 's/^common=//p' "$d"/facts/* | sort -u)
    while IFS= read -r -u 3 i; do
        path=$(ws_decode "$(ws_fact "$d/facts/$i" path)")
        ws_trash_move "$path" "$d/facts/$i" pr "$(ws_fact "$d/pr/$i" pr-number)" \
            state "$(ws_fact "$d/pr/$i" pr-state)" oid "$(ws_fact "$d/pr/$i" pr-oid)" && rc=0 || rc=$?
        ((rc < 2)) || status=1
    done 3<"$d/plan"
    if ((${#WS_TICKET_TRASH[@]})); then
        while IFS= read -r -d '' ticket; do
            ws_trash_ticket_files "$ticket"
        done < <(printf '%s\0' "${!WS_TICKET_TRASH[@]}" | sort -z)
    fi
    echo "ws prune --restore <name> moves one back. ws prune --purge deletes old entries."
    return "$status"
}

ws_trash_scan() {
    local d e
    for d in "$WS_TRASH"/* "$WS_TRASH"/.[!.]* "$WS_TRASH"/..?*; do
        [[ $d != "$WS_TRASH/archive" && $d != "$WS_TRASH"/.tmp.* ]] || continue
        ws_trash_item "$d"
        ws_ticket_trash_dir "$d" || continue
        if ws_has_record "$d"; then
            for e in "$d"/* "$d"/.[!.]* "$d"/..?*; do
                ws_ticket_item "$e"
            done
        elif ws_holds_files "$d"; then
            printf 'leftover:%s\0' "$d"
        else
            printf 'empty:%s\0' "$d"
        fi
    done
}

ws_ticket_trash_dir() {
    [[ -d $1 && ! -L $1 && $1 != *.purging && ! -e $1/.git && ! -e $1.meta && ! -e $1.meta.tmp ]]
}

ws_trash_item() {
    if [[ $1 == *.meta && (-e $1 || -L $1) ]]; then
        printf 'entry:%s\0' "$1"
    elif [[ $1 == *.meta.tmp && (-e $1 || -L $1) && ! -e ${1%.meta.tmp} && ! -L ${1%.meta.tmp} ]]; then
        printf 'unfinished:%s\0' "$1"
    elif [[ -d $1 && ! -L $1 && ! -e $1.meta && (-e $1/.git || -e $1.meta.tmp || $1 == *.purging) ]]; then
        printf 'orphan:%s\0' "$1"
    fi
}

ws_ticket_item() {
    ws_trash_item "$1"
    if [[ -d $1 && ! -L $1 && $1 != *.meta* && $1 != *.purging && ! -e $1/.git && ! -e $1.meta && ! -e $1.meta.tmp ]] &&
        ! ws_ticket_file "$1"; then
        printf 'orphan:%s\0' "$1"
    fi
}

ws_name_orig() {
    local rel=${1#"$WS_TRASH"/}
    rel=${rel%.purging}
    if [[ $rel =~ ^$WS_STAMP_RE-([^/]+)/([^/]+)$ ]]; then
        printf '%s\n' "$WS_ROOT/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"
    elif [[ $rel =~ ^$WS_STAMP_RE-([^/]+)$ ]]; then
        printf '%s\n' "$WS_PROJECTS/${BASH_REMATCH[2]}"
    else
        return 1
    fi
}

ws_main_of() {
    if [[ $1 == */.git ]]; then
        printf '%s\n' "${1%/.git}"
    else
        printf '%s\n' "$1"
    fi
}

ws_repos_shown() {
    local repo out=""
    for repo; do
        out+="${out:+, }$(ws_shown "$(ws_main_of "$repo")")"
    done
    printf '%s\n' "$out"
}

ws_linked() {
    local f first=1
    local -a fields=() paths=()
    mapfile -d '' fields < <(timeout -k 5 10 git --git-dir="$1" worktree list --porcelain -z 2>/dev/null)
    wait $! || return 1
    for f in "${fields[@]}"; do
        [[ $f == "worktree "* ]] || continue
        ((first)) || paths+=("${f#worktree }")
        first=0
    done
    ((${#paths[@]} == 0)) || realpath -m -z -- "${paths[@]}"
}

ws_listed() {
    local p real
    local -a paths=()
    mapfile -d '' paths < <(ws_linked "$1")
    wait $! || return 2
    real=$(realpath -m -- "$2")
    for p in "${paths[@]}"; do
        [[ $p != "$real" ]] || return 0
    done
    return 1
}

ws_gitdir_of() {
    local line=""
    [[ -f $1/.git && ! -L $1/.git ]] || return 1
    { IFS= read -r line <"$1/.git" || [[ -n $line ]]; } 2>/dev/null || return 1
    [[ $line == "gitdir: "?* ]] || return 1
    line=${line#gitdir: }
    [[ $line == /* ]] || line=$1/$line
    printf '%s\n' "$line"
}

ws_project_repos() {
    local d g
    for d in "$WS_PROJECTS"/*/; do
        d=${d%/}
        if [[ -d $d/.git && ! -L $d/.git ]]; then
            printf '%s\0' "$d/.git"
        elif g=$(ws_gitdir_of "$d") && [[ -f $g/HEAD && ! -e $g/commondir ]]; then
            printf '%s\0' "$g"
        elif [[ -f $d/HEAD && -d $d/objects && -d $d/refs ]]; then
            printf '%s\0' "$d"
        fi
    done
}

ws_snapshot_worktrees() {
    local repo real f p why
    local -a repos=() paths=()
    local -A seen=() m=()
    WS_WT_REPOS=() WS_WT_PATHS=() WS_WT_UNREAD=()
    mapfile -d '' repos < <(ws_project_repos)
    for f in "$WS_TRASH"/*.meta "$WS_TRASH"/*.meta.tmp "$WS_TRASH"/*/*.meta "$WS_TRASH"/*/*.meta.tmp; do
        if [[ -f $f ]] && ws_meta_read "$f" m why; then
            repos+=("${m[common]}")
        fi
    done
    for repo in "${repos[@]}" "${WS_SCANNED_REPOS[@]}" "$@"; do
        [[ -d $repo ]] || continue
        real=$(realpath -m -- "$repo")
        [[ -z ${seen[$real]+set} ]] || continue
        seen[$real]=1
        mapfile -d '' paths < <(ws_linked "$repo")
        if ! wait $!; then
            WS_WT_UNREAD+=("$repo")
            continue
        fi
        for p in "${paths[@]}"; do
            WS_WT_REPOS+=("$repo")
            WS_WT_PATHS+=("$p")
        done
    done
}

ws_lists_in() {
    local real i
    real=$(realpath -m -- "$1")
    WS_HITS=()
    for i in "${!WS_WT_PATHS[@]}"; do
        ! ws_within "${WS_WT_PATHS[i]}" "$real" || WS_HITS+=("$i")
    done
    ((${#WS_HITS[@]}))
}

ws_used_path() {
    ws_within "$1" "$2" || ws_within "$1" "$2.purging" || ws_within "$1" "$3" ||
        [[ $1 == "$3".* && ${1#"$3".} =~ ^[0-9]+$ ]]
}

ws_lists_used() {
    local e=$1 orig at="" i
    orig=$(realpath -m -- "$2")
    [[ -z ${3-} ]] || at=$(realpath -m -- "$3")
    WS_HITS=()
    for i in "${!WS_WT_PATHS[@]}"; do
        if ws_used_path "${WS_WT_PATHS[i]}" "$e" "$orig" || { [[ -n $at ]] && ws_within "${WS_WT_PATHS[i]}" "$at"; }; then
            WS_HITS+=("$i")
        fi
    done
    ((${#WS_HITS[@]}))
}

ws_gitfile_ok() {
    local admin back=""
    admin=$(ws_gitdir_of "$1") || return 1
    admin=$(realpath -m -- "$admin")
    [[ ${admin%/*} == "$(realpath -m -- "$2")/worktrees" ]] || return 1
    { IFS= read -r back <"$admin/gitdir" || [[ -n $back ]]; } 2>/dev/null || return 1
    [[ $back == /* ]] || back=$admin/$back
    [[ $(realpath -m -- "$back") == "$(realpath -m -- "$1")/.git" ]]
}

ws_move_cmd() {
    local main target mk=""
    main=$(ws_main_of "$1")
    target=$(ws_free_path "$3")
    [[ -d ${target%/*} ]] || mk="mkdir -p -- $(printf %q "${target%/*}") && "
    printf '    %sgit -C %q worktree move %q %q\n' "$mk" "$main" "$2" "$target"
    [[ $target == "$3" ]] || echo "$(ws_shown "$3") is taken, so that command puts it at $(ws_shown "$target")."
}

ws_hits_note() {
    local lead=$1 d=$2 why=${3-} real i repo admin listed=""
    real=$(realpath -m -- "$d")
    repo=${WS_WT_REPOS[WS_HITS[0]]}
    for i in "${WS_HITS[@]}"; do
        if [[ ${WS_WT_PATHS[i]} == "$real" ]]; then
            listed+="${listed:+, and }$(ws_repos_shown "${WS_WT_REPOS[i]}") lists it"
        else
            listed+="${listed:+, and }$(ws_repos_shown "${WS_WT_REPOS[i]}") lists a worktree in it, at $(ws_shown "${WS_WT_PATHS[i]}")"
            : "${why:=ws moves a worktree only when it is the whole directory}"
        fi
    done
    if [[ -n $why ]]; then
        :
    elif ((${#WS_HITS[@]} > 1)); then
        why="more than one repo lists it, so ws cannot tell which one owns it"
    elif [[ -L $d/.git ]]; then
        why="its .git is a symlink, so ws cannot tell which repo owns it"
    elif ! admin=$(ws_gitdir_of "$d"); then
        why="it holds no .git file that names a repo"
    else
        admin=$(realpath -m -- "$admin")
        if [[ ! -e $admin ]]; then
            why="its .git file points at $(ws_shown "$admin"), which is gone, so ws cannot tell which repo owns it"
        elif [[ ${admin%/*} != "$(realpath -m -- "$repo")/worktrees" ]]; then
            why="its .git file points at $(ws_shown "$admin"), which is not in $(ws_repos_shown "$repo"), so ws cannot tell which repo owns it"
        else
            why="its .git file points at $(ws_shown "$admin"), which names another path, so ws cannot tell which repo owns it"
        fi
    fi
    printf '%s %s. ws keeps it, since %s.\n' "$lead" "${listed^}" "$why"
}

ws_dir_note() {
    local d=$1 record=$2 lead=$3 orig="" why repo i
    local -A m=()
    if [[ -n $record ]] && ws_meta_read "$record" m why; then
        orig=${m[orig]}
        lead+=" Its record says it came from $(ws_shown "$orig")."
    elif orig=$(ws_name_orig "$d"); then
        lead+=" Its trash name says it came from $(ws_shown "$orig")."
    fi
    if [[ -L $d || ! -d $d ]]; then
        printf '%s It is no directory, so ws keeps it.\n' "$lead"
        return
    fi
    if ((${#WS_WT_UNREAD[@]})); then
        printf '%s ws keeps it, since it cannot read the worktree list of %s.\n' "$lead" \
            "$(ws_repos_shown "${WS_WT_UNREAD[@]}")"
        return
    fi
    if ! ws_lists_in "$d"; then
        ws_plain_dir_note "$d" "$lead" "$orig" "${m[at]-}"
        return
    fi
    i=${WS_HITS[0]}
    repo=${WS_WT_REPOS[i]}
    if ((${#WS_HITS[@]} > 1)) || [[ ${WS_WT_PATHS[i]} != "$(realpath -m -- "$d")" ]] || ! ws_gitfile_ok "$d" "$repo"; then
        ws_hits_note "$lead" "$d"
    elif [[ -z $orig ]]; then
        printf '%s %s lists it. Move it to a free path out of the trash with git -C %q worktree move %q and that path.\n' \
            "$lead" "$(ws_repos_shown "$repo")" "$(ws_main_of "$repo")" "$d"
    else
        printf '%s %s lists it. Move it out of the trash with:\n' "$lead" "$(ws_repos_shown "$repo")"
        ws_move_cmd "$repo" "$d" "$orig"
    fi
}

ws_plain_dir_note() {
    local d=$1 lead=$2 orig=$3 at=${4-} out
    local -a dirs=()
    lead+=" No repo lists a worktree in it."
    if [[ -n $orig ]] && ws_lists_used "${d%.purging}" "$orig" "$at"; then
        lead+=" Git lists its worktree at $(ws_shown "${WS_WT_PATHS[WS_HITS[0]]}")."
    fi
    if out=$(find "$d" ! -type d -print -quit 2>/dev/null) && [[ -z $out ]] &&
        mapfile -d '' dirs < <(find "$d" -depth -type d -print0 2>/dev/null) && wait $!; then
        printf '%s It holds no files. Remove it with:\n    rmdir --' "$lead"
        printf ' %q' "${dirs[@]}"
        echo
    else
        printf '%s ws keeps what it holds.\n' "$lead"
    fi
}

ws_leftover_note() {
    local d=$1 lead
    lead="Kept $(ws_shown "$d"): it holds no record."
    if ((${#WS_WT_UNREAD[@]})); then
        printf '%s ws keeps it, since it cannot read the worktree list of %s.\n' "$lead" \
            "$(ws_repos_shown "${WS_WT_UNREAD[@]}")"
    elif ws_lists_in "$d"; then
        ws_hits_note "$lead" "$d" "without a record ws cannot tell where it belongs"
    else
        ws_plain_dir_note "$d" "$lead" ""
    fi
}

ws_orphan_note() {
    local d=$1 lead=${2-} record=${3-} e=${1%.purging}
    if [[ -n $record ]]; then
        :
    elif [[ -e $d.meta.tmp || -L $d.meta.tmp ]]; then
        record=$d.meta.tmp lead="Orphan $(ws_shown "$d") has an unfinished record."
    elif [[ $d == *.purging && (-e $e.meta || -L $e.meta) ]]; then
        record=$e.meta lead="Orphan $(ws_shown "$d") is an entry a purge renamed; its record is $(ws_shown "$e.meta")."
    else
        lead="Orphan $(ws_shown "$d") has no record."
    fi
    ws_dir_note "$d" "$record" "$lead"
}

ws_record_note() {
    local record=$1 lead=$2 e=${1%.tmp} why i path orig kept="" out=""
    local -A m=()
    e=${e%.meta}
    if ! ws_meta_read "$record" m why; then
        printf '%s ws cannot read it (%s), so it keeps it. Read it before you delete it.\n' "$lead" "$why"
        return 0
    fi
    lead+=" It was for $(ws_shown "${m[orig]}")."
    if ((${#WS_WT_UNREAD[@]})); then
        printf '%s ws keeps it, since it cannot read the worktree list of %s.\n' "$lead" \
            "$(ws_repos_shown "${WS_WT_UNREAD[@]}")"
        return 0
    fi
    if ! ws_lists_used "$e" "${m[orig]}" "${m[at]-}"; then
        if [[ $record == *.meta ]]; then
            printf '%s No repo lists its worktree at a path ws used, so a purge or you removed it. Delete the record with:\n    rm -- %q\n' \
                "$lead" "$record"
        else
            printf '%s ws keeps it, since it is unfinished and no repo lists its worktree at a path ws used.\n' "$lead"
        fi
        return 0
    fi
    orig=$(realpath -m -- "${m[orig]}")
    for i in "${WS_HITS[@]}"; do
        path=${WS_WT_PATHS[i]}
        if [[ $path == "$orig" || ($path == "$orig".* && ${path#"$orig".} =~ ^[0-9]+$) ]]; then
            out=$path
        else
            kept=$path
        fi
    done
    if [[ -n $kept ]]; then
        printf '%s Git lists its worktree at %s, so ws keeps the record.\n' "$lead" "$(ws_shown "$kept")"
    elif [[ ! -f $out/.git ]]; then
        printf '%s Git lists its worktree at %s, which holds no .git file, so ws keeps the record.\n' "$lead" \
            "$(ws_shown "$out")"
    else
        printf '%s Git lists its worktree at %s, out of the trash, so the record is stale. Delete it with:\n    rm -- %q\n' \
            "$lead" "$(ws_shown "$out")" "$record"
    fi
}

ws_trash_notes() {
    local rec meta e why repo
    local -A m=()
    ws_snapshot_worktrees
    while IFS= read -r -d '' rec; do
        meta=${rec#*:} e=${meta%.meta}
        case $rec in
        orphan:*) ws_orphan_note "$meta" ;;
        unfinished:*) ws_record_note "$meta" "Unfinished record $(ws_shown "$meta") has no directory." ;;
        leftover:*) ws_leftover_note "$meta" ;;
        empty:*) printf 'Empty %s holds nothing. Remove it with:\n    rmdir -- %q\n' "$(ws_shown "$meta")" "$meta" ;;
        entry:*)
            if ! ws_meta_read "$meta" m why; then
                if [[ -d $e && ! -L $e ]]; then
                    ws_orphan_note "$e" "Kept $(ws_shown "$e"): bad record ($why)." "$meta"
                else
                    printf 'Kept %s: bad record (%s). ws ignores it; read %s before you delete it.\n' \
                        "$(ws_shown "$e")" "$why" "$(ws_shown "$meta")"
                fi
            elif [[ ! -e $e && ! -L $e && ! -e $e.purging && ! -L $e.purging ]]; then
                ws_record_note "$meta" "Record $(ws_shown "$meta") has no directory."
            elif [[ ! -e $e && ! -L $e ]]; then
                :
            elif ! repo=$(ws_entry_repo "$e"); then
                ws_orphan_note "$e" "Kept $(ws_shown "$e"): $repo." "$meta"
            elif [[ $repo != "${m[common]}" ]] && ws_clean_path "$repo" && ws_record_set "$meta" common "$repo" "$e"; then
                echo "Record $(ws_shown "$meta") now names $(ws_shown "$(ws_main_of "$repo")"), which lists its worktree."
            fi
            ;;
        esac
    done < <(ws_trash_scan)
}

ws_landed() {
    [[ -f $2/.git ]] && ws_listed "$1" "$(realpath -m -- "$2")"
}

# git worktree move puts src inside dst when dst is already a directory.
ws_move() {
    local common=$1 src=$2 dst=$3 inner back
    WS_MOVED_TO=
    git --git-dir="$common" worktree move "$src" "$dst" </dev/null || return 1
    ws_landed "$common" "$dst" && return 0
    inner=$(realpath -m -- "$dst")/${src##*/}
    if ! ws_landed "$common" "$inner"; then
        echo "ws: git moved $(ws_shown "$src"), but not to $(ws_shown "$dst") or inside it" >&2
        return 2
    fi
    if git --git-dir="$common" worktree move "$inner" "$src" </dev/null && ws_landed "$common" "$src"; then
        echo "ws: $(ws_shown "$dst") appeared while ws moved $(ws_shown "$src") there, so it stays where it was" >&2
        return 1
    fi
    back=$(realpath -m -- "$src")/${src##*/}
    if ws_landed "$common" "$inner"; then
        WS_MOVED_TO=$inner
    elif ws_landed "$common" "$back"; then
        WS_MOVED_TO=$back
    fi
    echo "ws: another process made $(ws_shown "$dst") while ws moved $(ws_shown "$src") there, and ws could not move it back; it is at $(ws_shown "${WS_MOVED_TO:-a path ws cannot find}")" >&2
    return 2
}

ws_entry_repo() {
    local common rc real real_common i other
    if [[ $1 == *[$'\t\n']* ]]; then
        echo "a tab or newline in its path"
    elif [[ -L $1 ]]; then
        echo "it is a symlink"
    elif [[ ! -d $1 ]]; then
        echo "its directory is missing"
    elif [[ -L $1/.git ]]; then
        echo "its .git is a symlink"
    elif [[ ! -f $1/.git ]]; then
        echo "it holds no .git file"
    elif ! common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
        echo "git cannot open it"
    elif ((${#WS_WT_UNREAD[@]})); then
        echo "ws cannot read the worktree list of $(ws_repos_shown "${WS_WT_UNREAD[@]}")"
    else
        ws_listed "$common" "$1" && rc=0 || rc=$?
        case $rc in
        0)
            if ws_lists_in "$1"; then
                real=$(realpath -m -- "$1")
                real_common=$(realpath -m -- "$common")
                for i in "${WS_HITS[@]}"; do
                    if [[ ${WS_WT_PATHS[i]} != "$real" || $(realpath -m -- "${WS_WT_REPOS[i]}") != "$real_common" ]]; then
                        other=it
                        [[ ${WS_WT_PATHS[i]} == "$real" ]] || other=$(ws_shown "${WS_WT_PATHS[i]}")
                        echo "$(ws_repos_shown "$common") lists it, and $(ws_repos_shown "${WS_WT_REPOS[i]}") lists $other too"
                        return 1
                    fi
                done
            fi
            printf '%s\n' "$common"
            return 0
            ;;
        1) echo "git does not list it as a worktree of $(ws_shown "$(ws_main_of "$common")")" ;;
        *) echo "ws cannot read the worktree list of $(ws_shown "$(ws_main_of "$common")")" ;;
        esac
    fi
    return 1
}

prune_restore_one() {
    local meta=$1 e=${1%.meta} orig ticket tdir f why common stop=0
    local -a files=()
    local -A m=()
    if ! ws_meta_read "$meta" m why; then
        echo "ws: cannot restore $(ws_shown "$e"): bad record ($why)" >&2
        return 1
    fi
    orig=${m[orig]} ticket=${m[ticket]} tdir=${e%/*}
    if [[ -e $orig || -L $orig ]]; then
        echo "ws: cannot restore $(ws_shown "$e"): $(ws_shown "$orig") exists" >&2
        return 1
    fi
    if ! common=$(ws_entry_repo "$e"); then
        echo "ws: cannot restore $(ws_shown "$e"): $common" >&2
        return 1
    fi
    if [[ -n $ticket ]]; then
        for f in "$tdir"/* "$tdir"/.[!.]* "$tdir"/..?*; do
            [[ -e $f || -L $f ]] || continue
            ws_ticket_file "$f" || continue
            files+=("$f")
            if [[ -e $ticket/${f##*/} || -L $ticket/${f##*/} ]]; then
                echo "ws: cannot restore $(ws_shown "$e"): $(ws_shown "$ticket/${f##*/}") exists, and the trash holds $(ws_shown "$f")" >&2
                stop=1
            fi
        done
        ((stop == 0)) || return 1
    fi
    mkdir -p -- "${orig%/*}" || return 1
    for f in "${files[@]}"; do
        if ! mv -n -- "$f" "$ticket/" || [[ -e $f || -L $f ]]; then
            echo "ws: cannot move $(ws_shown "$f") to $(ws_shown "$ticket")" >&2
            return 1
        fi
    done
    if ! ws_move "$common" "$e" "$orig"; then
        ws_record_at "$meta" "$WS_MOVED_TO"
        return 1
    fi
    rm -f -- "$meta"
    [[ -z $ticket ]] || rmdir -- "$tdir" 2>/dev/null || true
    echo "Restored $(ws_shown "$orig")"
}

prune_restore_ticket() {
    local want=$1 rec d id why to
    local -a dirs=() ids=()
    while IFS= read -r -d '' rec; do
        [[ $rec == leftover:* ]] || continue
        d=${rec#*:}
        [[ ${d#"$WS_TRASH"/} =~ ^$WS_STAMP_RE-(.+)$ ]] || continue
        id=${BASH_REMATCH[2]}
        ticket_name_ok "$id" || continue
        if [[ $want == "$id" || ($want == */* && $(realpath -m -- "$d") == "$want") ]]; then
            dirs+=("$d")
            ids+=("$id")
        fi
    done < <(ws_trash_scan)
    if ((${#dirs[@]} == 0)); then
        echo "ws: nothing in $(ws_shown "$WS_TRASH") matches $2" >&2
        return 1
    fi
    if ((${#dirs[@]} > 1)); then
        echo "ws: $2 matches more than one trash entry; name one by its trash path:" >&2
        printf '  %s\n' "${dirs[@]/#"$HOME/"/\~/}" >&2
        return 1
    fi
    d=${dirs[0]} to=$WS_ROOT/${ids[0]}
    if [[ -e $to || -L $to ]]; then
        echo "ws: cannot restore $(ws_shown "$d"): $(ws_shown "$to") exists" >&2
        return 1
    fi
    ws_engine_mounts
    if why=$(ws_ticket_blocker "$d"); then
        echo "ws: cannot restore $(ws_shown "$d"): $why" >&2
        return 1
    fi
    if ! mkdir -p -- "$WS_ROOT" || ! mv -n -T -- "$d" "$to" || [[ -e $d || ! -d $to ]]; then
        echo "ws: cannot move $(ws_shown "$d") to $(ws_shown "$to")" >&2
        return 1
    fi
    echo "Restored $(ws_shown "$to")"
}

ws_restore_hit() {
    local want=$1 p
    shift
    for p; do
        if [[ ($want == */* && $(realpath -m -- "$p") == "$want") || ($want != */* && ${p##*/} == "$want") ]]; then
            return 0
        fi
    done
    return 1
}

prune_restore() {
    local want=$1 rec meta e why ticket shared=1 status=0
    local -a hits=() tickets=()
    local -A m=()
    [[ $want != */* ]] || want=$(realpath -m -- "$want")
    ws_snapshot_worktrees
    while IFS= read -r -d '' rec; do
        [[ $rec == entry:* ]] || continue
        meta=${rec#*:} e=${meta%.meta}
        if ! ws_meta_read "$meta" m why; then
            if ws_restore_hit "$want" "$e"; then
                hits+=("$meta")
                tickets+=("")
            fi
        elif ws_restore_hit "$want" "$e" "${m[orig]}" ${m[ticket]:+"${m[ticket]}" "${e%/*}"}; then
            hits+=("$meta")
            tickets+=("${m[ticket]}")
        fi
    done < <(ws_trash_scan)
    for ticket in "${tickets[@]}"; do
        [[ -n $ticket && $ticket == "${tickets[0]}" ]] || shared=0
    done
    if ((${#hits[@]} == 0)); then
        prune_restore_ticket "$want" "$1" || status=1
    elif ((${#hits[@]} > 1 && ! shared)); then
        echo "ws: $1 matches more than one trash entry; name one by its trash path:" >&2
        for meta in "${hits[@]}"; do
            echo "  $(ws_shown "${meta%.meta}")" >&2
        done
        status=1
    else
        for meta in "${hits[@]}"; do
            prune_restore_one "$meta" || status=1
        done
    fi
    ws_trash_notes
    return "$status"
}

ws_decimal_le() {
    [[ ${#1} -lt ${#2} || (${#1} -eq ${#2} && ! $1 > $2) ]]
}

ws_bundle_path() {
    local p=$WS_TRASH/archive/${1#"$WS_TRASH"/} k=1 out
    out=$p.bundle
    while [[ -e $out || -L $out ]]; do
        k=$((k + 1))
        out=$p.$k.bundle
    done
    printf '%s\n' "$out"
}

# git worktree remove and branch deletion drop the reflogs of HEAD, the
# branch, and per-worktree refs, so gc would drop commits only they reach.
ws_save_reflog() (
    wt=$1 common=$2 branch=$3 out=$4
    wtrefs=("${@:5}")
    set -o pipefail
    tmp=$(ws_tmp_dir) || exit 1
    trap 'rm -rf -- "$tmp"' EXIT
    git -C "$wt" log -g --format=%H HEAD ${branch:+"refs/heads/$branch"} "${wtrefs[@]}" -- >"$tmp/tips" ||
        exit 1
    sort -u "$tmp/tips" >"$tmp/revs" || exit 1
    [[ -s $tmp/revs ]] || exit 0
    git -C "$wt" rev-list --ignore-missing --boundary --parents --stdin --not --all <"$tmp/revs" >"$tmp/list" ||
        exit 1
    n=0
    declare -A parent=()
    echo --not >"$tmp/edges"
    while read -r commit parents; do
        if [[ $commit == -* ]]; then
            echo "${commit#-}" >>"$tmp/edges"
        else
            n=$((n + 1))
            for p in $parents; do
                parent[$p]=1
            done
        fi
    done <"$tmp/list"
    ((n)) || exit 0
    git init -q --bare --object-format="$(git -C "$wt" rev-parse --show-object-format)" "$tmp/r" || exit 1
    git --git-dir="$common" rev-parse --path-format=absolute --git-path objects \
        >"$tmp/r/objects/info/alternates" || exit 1
    while read -r commit _; do
        [[ $commit == -* || -n ${parent[$commit]+set} ]] || printf 'create refs/heads/r%s %s\n' "$commit" "$commit"
    done <"$tmp/list" | git --git-dir="$tmp/r" update-ref --stdin || exit 1
    { echo --branches && cat "$tmp/edges"; } | git --git-dir="$tmp/r" bundle create -q "$tmp/bundle" --stdin ||
        exit 1
    if ! v=$(git --git-dir="$common" bundle verify -q "$tmp/bundle" 2>&1); then
        printf '%s\n' "$v" >&2
        exit 1
    fi
    mkdir -p -- "${out%/*}" || exit 1
    if [[ -e $out || -L $out ]]; then
        echo "ws: $(ws_shown "$out") exists, so ws does not save the bundle there" >&2
        exit 1
    fi
    ino=$(stat -c %i -- "$tmp/bundle") && ln -T -- "$tmp/bundle" "$out" || exit 1
    [[ -f $out && ! -L $out && $(stat -c %i -- "$out") == "$ino" ]] || exit 1
    echo "Saved $n commit(s) that only its reflogs held to $(ws_shown "$out")"
)

ws_pid_ns() {
    local ns
    ns=$(readlink /proc/self/ns/pid 2>/dev/null) || return 1
    [[ $ns =~ ^pid:\[([0-9]+)\]$ ]] || return 1
    printf '%s\n' "${BASH_REMATCH[1]}"
}

ws_tmp_dir() {
    local ns
    ns=$(ws_pid_ns) || ns=0
    mktemp -d -- "$WS_TRASH/.tmp.$$.$ns.XXXXXX"
}

# /proc lists only this pid namespace, so a pid from another namespace
# says nothing about whether that run is alive. The last NSpid field is
# the pid a process has in its own namespace.
ws_drop_dead_tmp() {
    local d name ns pid run_ns why
    ns=$(ws_pid_ns) || ns=
    for d in "$WS_TRASH"/.tmp.*; do
        name=${d##*/} why=
        [[ -d $d && ! -L $d ]] || continue
        if [[ $name =~ ^\.tmp\.([0-9]+)\.([0-9]+)\.[A-Za-z0-9]{6}$ ]]; then
            pid=${BASH_REMATCH[1]} run_ns=${BASH_REMATCH[2]}
            [[ -n $ns && $run_ns == "$ns" && ! -e /proc/$pid ]] || continue
        elif [[ $name =~ ^\.tmp\.([0-9]+)\.[A-Za-z0-9]{6}$ ]]; then
            pid=${BASH_REMATCH[1]}
            if [[ $ns != "$WS_PROC_PID_INIT_INO" ]]; then
                why="ws runs outside the host's pid namespace, so it cannot tell whether run $pid is gone"
            elif grep -qsE "^NSpid:.*[[:space:]]$pid\$" /proc/[0-9]*/status; then
                why="a process with pid $pid runs"
            fi
        elif [[ $name =~ ^\.tmp\.[A-Za-z0-9]{6}$ ]]; then
            why="its name holds no pid, so ws cannot tell whether that run is gone"
        else
            continue
        fi
        if [[ -n $why ]]; then
            echo "Kept $(ws_shown "$d"): an older ws run made it, and $why. Delete it when no ws runs."
        elif rm -rf -- "$d"; then
            echo "Removed $(ws_shown "$d"), which a ws run that died left behind."
        fi
    done
}

ws_archive_ticket() {
    local tdir=$1 adir why
    if [[ $tdir == "$WS_TRASH" ]] || ws_holds_entries "$tdir" || rmdir -- "$tdir" 2>/dev/null; then
        return 0
    fi
    if why=$(ws_ticket_blocker "$tdir"); then
        echo "Kept $(ws_shown "$tdir"): $why"
        return 1
    fi
    adir=$(ws_free_path "$WS_TRASH/archive/${tdir##*/}")
    if mkdir -p -- "$adir" && ws_move_entries "$tdir" "$adir"; then
        echo "Moved the ticket files in $(ws_shown "$tdir") to $(ws_shown "$adir")"
    else
        echo "Kept $(ws_shown "$tdir"): its files could not all move to $(ws_shown "$adir")"
        return 1
    fi
}

prune_purge_one() {
    local d=$1 i=$2 e purging common branch orig="" reason detail line why fail=0
    local -a refs=()
    local -A m=()
    e=$(ws_decode "$(ws_fact "$d/facts/$i" path)")
    purging=$e.purging
    common=$(ws_decode "$(ws_fact "$d/facts/$i" common)")
    branch=$(ws_decode "$(ws_fact "$d/facts/$i" branch)")
    ! ws_meta_read "$e.meta" m why || orig=${m[orig]}
    WS_MOVED_TO=
    if [[ -e $purging || -L $purging ]] || ! ws_move "$common" "$e" "$purging"; then
        ws_record_at "$e.meta" "$WS_MOVED_TO"
        echo "Kept $(ws_shown "$e"): it could not move to $(ws_shown "$purging")"
        return 1
    fi
    ws_engine_mounts
    ws_wt_facts "$purging" "$e" ${orig:+"$orig"} >"$d/recheck" 2>/dev/null
    reason=$(prune_classify 1 "" "$d/recheck" "$d/pr/$i")
    while IFS= read -r line; do
        [[ $line != wtref=* ]] || refs+=("$(ws_decode "${line#wtref=}")")
    done <"$d/recheck"
    if [[ $reason != action=REMOVE ]]; then
        detail=$(ws_get "$reason" detail) || detail=
        reason="KEEP $(ws_get "$reason" reason)${detail:+ ($(ws_detail "$detail"))}"
    elif [[ $(sed 1d "$d/recheck") != "$(sed 1d "$d/facts/$i")" ]]; then
        reason="it changed after the scan"
    elif ! ws_save_reflog "$purging" "$common" "$branch" "$(ws_bundle_path "$e")" "${refs[@]}"; then
        reason="the commits only its reflogs hold could not be saved"
        fail=1
    elif ! git -c status.showUntrackedFiles=all --git-dir="$common" worktree remove "$purging" </dev/null; then
        reason="git worktree remove failed"
        fail=1
    else
        reason=
    fi
    if [[ -n $reason ]]; then
        if [[ ! -e $e && ! -L $e ]] && ws_listed "$common" "$purging"; then
            if ws_move "$common" "$purging" "$e"; then
                echo "Kept $(ws_shown "$e"): $reason"
                return "$fail"
            fi
            ws_record_at "$e.meta" "$WS_MOVED_TO"
        fi
        echo "Kept $(ws_shown "${WS_MOVED_TO:-$purging}"): $reason"
        if [[ -z $WS_MOVED_TO ]]; then
            ws_snapshot_worktrees
            ws_orphan_note "$purging"
        fi
        return 1
    fi
    rm -f -- "$e.meta"
    echo "Deleted $(ws_shown "$e")"
    if [[ $(ws_fact "$d/pr/$i" pr-state) == merged ]]; then
        prune_delete_branch "$common" "$branch" "$(ws_fact "$d/pr/$i" pr-oid)" "$(ws_fact "$d/pr/$i" pr-number)"
    fi
    ws_archive_ticket "${e%/*}"
}

prune_purge() {
    local d=$1 older=$2 cutoff stamp rec meta e rel why n noun=worktrees status=0 i
    local -A m=()
    if ! [[ $older =~ ^[0-9]{1,5}d$ ]]; then
        echo "ws: --older-than takes days, such as 14d" >&2
        return 1
    fi
    cutoff=$(($(date +%s) - 10#${older%d} * 86400))
    stamp=$(date -u -d "@$cutoff" +%Y%m%dT%H%M%SZ)
    : >"$d/entries"
    ws_snapshot_worktrees
    while IFS= read -r -d '' rec; do
        [[ $rec == entry:* ]] || continue
        meta=${rec#*:} e=${meta%.meta} rel=${meta#"$WS_TRASH"/}
        if ! ws_meta_read "$meta" m why || [[ ! -e $e && ! -L $e ]] || ! ws_entry_repo "$e" >/dev/null; then
            continue
        elif [[ ! ${rel:0:16} > $stamp ]] && ws_decimal_le "${m[time]}" "$cutoff"; then
            printf '%s\n' "$e" >>"$d/entries"
        fi
    done < <(ws_trash_scan) >"$d/notes"
    ws_trash_notes >>"$d/notes"
    if [[ ! -s $d/entries ]]; then
        echo "Nothing in the trash is older than $older."
        cat "$d/notes"
        return 0
    fi
    prune_plan "$d" 1 "" <"$d/entries" || return
    prune_report "$d/table"
    echo
    if [[ -s $d/notes ]]; then
        cat "$d/notes"
        echo
    fi
    n=$(wc -l <"$d/plan")
    if ((n == 0)); then
        echo "Nothing to delete."
        return 0
    fi
    ((n > 1)) || noun=worktree
    if ! ws_confirm "Delete $n $noun from the trash?"; then
        echo "Nothing deleted."
        return 0
    fi
    while IFS= read -r -u 3 i; do
        prune_purge_one "$d" "$i" || status=1
    done 3<"$d/plan"
    return "$status"
}

prune_scan() {
    local d=$1 include_detached=$2 tickets=()
    if [[ -d $WS_ROOT ]]; then
        mapfile -d '' tickets < <(find -H "$WS_ROOT" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)
    fi
    ws_worktrees "$WS_PROJECTS" "${tickets[@]}" >"$d/worktrees"
    prune_plan "$d" "$include_detached" "$(ws_dev_of "$WS_TRASH")" <"$d/worktrees" || return
    prune_report "$d/table"
}

ws_prune() {
    local mode=scan include_detached=0 older=14d given_older=0 target="" d rc=0
    while (($#)); do
        case $1 in
        --apply) [[ $mode == scan ]] && mode=apply || mode=bad ;;
        --include-detached) include_detached=1 ;;
        --purge) [[ $mode == scan ]] && mode=purge || mode=bad ;;
        --restore)
            [[ $# -ge 2 && $mode == scan ]] && mode=restore || mode=bad
            target=${2-}
            shift
            ;;
        --older-than)
            [[ $# -ge 2 ]] || mode=bad
            older=${2-}
            given_older=1
            shift
            ;;
        -h | --help)
            prune_usage
            return 0
            ;;
        *) mode=bad ;;
        esac
        [[ $# -eq 0 ]] || shift
    done
    if [[ $mode == bad || ($given_older == 1 && $mode != purge) ]]; then
        prune_usage >&2
        return 1
    fi

    WS_TRASH=$(realpath -m -- "$WS_TRASH") || return 1
    ws_env_ok || return 1
    [[ $mode == scan ]] || ws_drop_dead_tmp
    d=$(mktemp -d) || return 1
    case $mode in
    scan) prune_scan "$d" "$include_detached" || rc=$? ;;
    apply)
        prune_scan "$d" "$include_detached" && {
            echo
            prune_apply "$d"
        } || rc=$?
        ;;
    purge) prune_purge "$d" "$older" || rc=$? ;;
    restore) prune_restore "$target" || rc=$? ;;
    esac
    rm -rf "$d"
    return "$rc"
}

ticket_usage() {
    cat <<'EOF'
usage: ws new [--ticket <key>] [--topic <name>] <id> <branch> <repo>...
       ws adopt <id> <worktree>...
       ws ls
       ws pick [--print]
       ws stage [<id>] <stage>
       ws status [--refresh | --waiting]
       ws up [--wait] [<id>]
       ws down [<id>]
       ws rm [--purge] <id>
       ws scenarios [<id>] [--from <file>] [--replace]
       ws verify [<id>]
       ws done [<id>]

A ticket is the directory $WS_ROOT/<id>. It holds .ws, the ticket state
that only ws writes, a CLAUDE.md that ws writes, a .claude/settings.json
that denies Claude edits of the ticket's scenarios, .ws, and evidence,
and one git worktree of $WS_PROJECTS/<repo> per repo, all on one branch.
Its tmux session is named <id> and has the windows claude, shell, and
env. Ids, --ticket, and --topic take ASCII letters, digits, dots,
dashes, and underscores.

  new     make what is missing of the ticket: the worktrees, .ws,
          CLAUDE.md, .claude/settings.json, and the tmux session, whose
          claude window runs claude -n <id>. Then switch to the
          session. A branch that exists in neither the repo nor origin
          starts from origin's default branch with no upstream. A rerun
          adds new repos and keeps the stage. It writes CLAUDE.md again
          only while nobody has edited it, and adds the deny rules to a
          settings.json that someone edited.
  adopt   move linked worktrees of one branch into the ticket with git
          worktree move, then do what new does. No process may work in
          them, no container may mount them, and no other ticket may
          hold them.
  ls      list the tickets with their stage, the Claude sessions that
          wait on you, PR state, env state, and branch.
  pick    list the tickets, then every directory in $WS_PROJECTS, then
          the vault, in fzf. Tickets with waiting sessions come first,
          then tickets at planned, qa, or review. Enter switches to the
          tmux session of the pick and makes it when it is missing.
          --print prints the list as <path><TAB><row>.
  stage   set the stage, one of spec planned building verifying qa
          review merged. Without <id>, the ticket of the current
          directory. Warns when more than 5 tickets are in building.
  status  --refresh asks claude agents --json and gh, and writes
          ~/.cache/ws/status.json. PR state is asked again only when it
          is WS_PR_TTL seconds old, 300 by default, or 60 seconds after
          gh failed. --waiting prints
          "N waiting" for every Claude session that waits on you. pick
          and --waiting start a refresh in the background. Without a
          flag, status refreshes and runs ls.
  up      run DOCKYARD_WORKSPACE=<ticket dir> dockyard up <branch>, write
          the slot and the URLs that dockyard prints to .ws and to the
          env lines of CLAUDE.md, and tail the container logs in the env
          window. up replaces that window only when it shows the logs of
          an earlier up or an idle shell; else it prints the command that
          tails them. When .ws has URLs and a container of the stack runs,
          up says the env is already up and skips dockyard. A failed
          dockyard up makes ws up exit with its status. --wait then asks
          each URL until it answers with an HTTP status below 500, for
          at most WS_UP_TIMEOUT seconds, 300 by default.
  down    run dockyard down <branch>, which stops the containers and
          keeps the slot and the volumes, and clear WS_URLS.
  rm      run ws down, then refuse when a worktree has a KEEP reason of
          ws prune -h, or when a process works in the ticket outside its
          tmux session and its background Claude sessions. Then stop
          those Claude sessions with claude stop, kill the tmux session,
          and move the worktrees and the ticket files to the trash. When
          a process outlives them, ws moves nothing. ws prune --restore
          <id> brings the ticket back. --purge then runs dockyard nuke
          <branch>, which removes the env's containers, volumes, and
          slot, and leaves the worktrees to ws.
  scenarios
          write the holdout scenarios of the ticket to
          $WS_VAULT/projects/work/<topic>/scenarios/<id>.md and record
          their sha256 as WS_SCENARIOS_SHA256 in .ws. A claude -p run
          in the vault, with no built-in tools, writes them from the
          ticket text in --from <file>, or from the Jira issue
          WS_TICKET. For Jira it may call one tool, WS_JIRA_TOOL of the
          MCP server WS_JIRA_MCP, getJiraIssue of atlassian by default.
          Inside a Claude session, where CLAUDECODE is set, it replaces
          scenarios that exist only with --replace. The
          .claude/settings.json that ws new writes in the ticket denies
          Claude edits of the scenarios, .ws, and the evidence of the
          ticket. These rules and the sha256 are speed bumps, not a
          sandbox. Claude Code applies the rules only to the shell
          writes it parses, such as redirects, cp, tee, and sed -i.
  verify  refuse when the scenarios changed since ws scenarios wrote
          them, or when the env is down. Else set the stage to
          verifying, start claude --bg -n <id>-verify --agent
          ui-tester in a new evidence directory
          $WS_VAULT/projects/work/<topic>/evidence/<id>/<date>, and
          wait at most WS_VERIFY_TIMEOUT seconds, 1800 by default, for
          its results.md. The session may not edit the scenarios, .ws,
          or the ticket directory. results.md holds one line per
          scenario, RESULT S<n> PASS or RESULT S<n> FAIL <why>. A
          scenario passes only when it has exactly one such line and
          that line is PASS. When every scenario passes, the stage
          becomes qa; else it goes back to building. A rerun waits on a
          verify session of the ticket that still runs.
  done    set the stage to merged and run $WS_VAULT/bin/vault-consolidate,
          then offer ws rm. When vault-consolidate fails, keep the
          ticket, because vault-consolidate archives the learnings of a
          merged ticket only while its .ws is in $WS_ROOT.

up, down, and rm act on the dockyard stack of the ticket's branch only
while its record in ~/.dockyard/slots.json names the ticket directory as
its workspace. A stack that another ticket or a plain dockyard up made
stays as it is.
EOF
}

ticket_name_ok() {
    local LC_ALL=C
    [[ $1 =~ $WS_NAME_RE ]]
}

ticket_branch_ok() {
    local LC_ALL=C
    [[ $1 =~ $WS_BRANCH_RE ]] && git check-ref-format --branch "$1" >/dev/null 2>&1
}

ticket_check_id() {
    if ! ticket_name_ok "$1"; then
        echo "ws: ticket id '$1' must start with an ASCII letter or digit and hold only ASCII letters, digits, dots, dashes, and underscores" >&2
        return 1
    fi
}

ticket_read() {
    local file=$1/.ws want=${3:-${1##*/}} content="" line key value n=0 shown LC_ALL=C
    local -n tr_kv=$2
    tr_kv=()
    REPLY=
    shown=${file/#"$HOME/"/\~/}
    if [[ ! -f $file || ! -r $file ]]; then
        REPLY="$shown is not a readable file"
        return 1
    fi
    IFS= read -r -d '' -N 65537 content <"$file" || true
    if ((${#content} > 65536)); then
        REPLY="$shown is over 64 KB"
        return 1
    fi
    while IFS= read -r line || [[ -n $line ]]; do
        n=$((n + 1))
        line=${line%$'\r'}
        [[ ! $line =~ ^[[:space:]]*(#|$) ]] || continue
        if [[ ! $line =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
            REPLY="line $n of $shown is not KEY=value"
            return 1
        fi
        key=${BASH_REMATCH[1]}
        value=${BASH_REMATCH[2]}
        if [[ $value =~ ^\"(.*)\"$ || $value =~ ^\'(.*)\'$ ]]; then
            value=${BASH_REMATCH[1]}
        elif [[ $value == [\"\']* ]]; then
            REPLY="line $n of $shown has an unclosed quote"
            return 1
        fi
        tr_kv["$key"]=$value
    done <<<"$content"
    if ! ticket_name_ok "${tr_kv[WS_ID]-}" || [[ ${tr_kv[WS_ID]} != "$want" ]]; then
        REPLY="WS_ID in $shown is not $want"
        return 1
    fi
    if [[ -n ${tr_kv[WS_TOPIC]-} ]] && ! ticket_name_ok "${tr_kv[WS_TOPIC]}"; then
        REPLY="WS_TOPIC in $shown is not a plain name"
        return 1
    fi
}

ticket_line() {
    if [[ $2 == *[\"\$\`\\[:cntrl:]]* ]]; then
        echo "ws: $1 holds a double quote, \$, backquote, backslash, or control character" >&2
        return 1
    fi
    if [[ $2 == *[!A-Za-z0-9._/:@%+=,-]* ]]; then
        REPLY="$1=\"$2\""
    else
        REPLY="$1=$2"
    fi
}

ticket_write() {
    local dir=$1 key out="" tmp LC_ALL=C
    local -n tw=$2
    local -A known=()
    for key in $WS_KEYS; do
        known[$key]=1
        ticket_line "$key" "${tw[$key]-}" || return 1
        out+=$REPLY$'\n'
    done
    while IFS= read -r key; do
        [[ -n $key && -z ${known[$key]+set} ]] || continue
        ticket_line "$key" "${tw[$key]}" || return 1
        out+=$REPLY$'\n'
    done < <(printf '%s\n' "${!tw[@]}" | sort)
    if ((${#out} > 65536)); then
        echo "ws: $dir/.ws would be over 64 KB" >&2
        return 1
    fi
    tmp=$(mktemp -- "$dir/.ws.XXXXXX") || return 1
    if printf '%s' "$out" >"$tmp" && mv -T -- "$tmp" "$dir/.ws"; then
        return 0
    fi
    rm -f -- "$tmp"
    return 1
}

ws_write_in_place() {
    if cmp -s -- "$2" "$1"; then
        rm -f -- "$2"
        return 0
    fi
    if ! : >>"$1"; then
        rm -f -- "$2"
        return 1
    fi
    if ! cat -- "$2" >"$1"; then
        echo "ws: writing $(ws_shown "$1") stopped partway; its new text is in $(ws_shown "$2")" >&2
        return 1
    fi
    rm -f -- "$2"
}

ticket_locked() {
    local fd rc=0
    exec {fd}<"$1" || return 1
    if flock -w 10 "$fd"; then
        "${@:2}" || rc=$?
    else
        echo "ws: $(ws_shown "$1") stayed locked for 10 seconds" >&2
        rc=1
    fi
    exec {fd}<&-
    return "$rc"
}

ticket_update() {
    local dir=$1 fd mode=set rc=0
    local -A kv=()
    shift
    exec {fd}<"$dir" || return 1
    if ! flock -w 10 "$fd"; then
        echo "ws: $(ws_shown "$dir") stayed locked for 10 seconds" >&2
        rc=1
    elif [[ -e $dir/.ws || -L $dir/.ws ]] && ! ticket_read "$dir" kv; then
        echo "ws: $REPLY" >&2
        rc=1
    else
        while (($#)); do
            case $1 in
            set | default)
                mode=$1
                shift
                continue
                ;;
            esac
            if [[ $mode == set || -z ${kv[$1]-} ]]; then
                kv[$1]=$2
            fi
            shift 2
        done
        ticket_write "$dir" kv || rc=1
    fi
    exec {fd}<&-
    return "$rc"
}

ticket_scan() {
    local dir id
    local -A kv=()
    T_IDS=() T_PLAIN=()
    T_STAGE=() T_BRANCH=() T_REPOS=() T_ENV=() T_BAD=()
    for dir in "$WS_ROOT"/*/; do
        dir=${dir%/}
        [[ -d $dir && ! -L $dir && $dir != *[$'\t\n']* ]] || continue
        id=${dir##*/}
        if [[ ! -e $dir/.ws && ! -L $dir/.ws ]]; then
            T_PLAIN+=("$dir")
            continue
        fi
        T_IDS+=("$id")
        if ! ticket_read "$dir" kv; then
            T_BAD[$id]=$REPLY
            continue
        fi
        T_STAGE[$id]=${kv[WS_STAGE]-}
        T_BRANCH[$id]=${kv[WS_BRANCH]-}
        T_REPOS[$id]=${kv[WS_REPOS]-}
        T_ENV[$id]=
        if [[ -n ${kv[WS_URLS]-} ]]; then
            T_ENV[$id]=up
        elif [[ -n ${kv[WS_SLOT]-} ]]; then
            T_ENV[$id]=down
        fi
    done
}

ticket_of_path() {
    local root rel
    root=$(realpath -m -- "$WS_ROOT")
    [[ $1 == "$root"/* ]] || return 1
    rel=${1#"$root"/}
    [[ -e $WS_ROOT/${rel%%/*}/.ws ]] || return 1
    printf '%s\n' "${rel%%/*}"
}

ticket_here() {
    local id
    if id=$(ticket_of_path "$(pwd -P)"); then
        printf '%s\n' "$WS_ROOT/$id"
        return 0
    fi
    echo "ws: $(ws_shown "$PWD") is not inside a ticket in $(ws_shown "$WS_ROOT"); run $1" >&2
    return 1
}

ticket_target() {
    local dir
    if (($# > 1)); then
        ticket_check_id "$2" || return 1
        dir=$WS_ROOT/$2
    else
        dir=$(ticket_here "$1") || return 1
    fi
    if [[ -L $dir || ! -d $dir || ! -e $dir/.ws ]]; then
        echo "ws: no ticket $(ws_shown "$dir")" >&2
        return 1
    fi
    REPLY=$dir
}

ticket_checked_out() {
    local f path=""
    local -a fields=()
    mapfile -d '' fields < <(git -C "$1" worktree list --porcelain -z 2>/dev/null)
    for f in "${fields[@]}"; do
        case $f in
        "worktree "*) path=${f#worktree } ;;
        "branch refs/heads/$2")
            printf '%s\n' "$path"
            return 0
            ;;
        esac
    done
    return 1
}

ticket_wt_ready() {
    local wt=$1/$2 main=$WS_PROJECTS/$2 common head
    [[ -d $wt && ! -L $wt && -f $wt/.git ]] &&
        common=$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) &&
        [[ $(realpath -m -- "$common") == "$(realpath -m -- "$main/.git")" ]] &&
        head=$(git -C "$wt" symbolic-ref -q HEAD) && [[ $head == "refs/heads/$3" ]]
}

ticket_wt_blocker() {
    local wt=$1/$2 main=$WS_PROJECTS/$2 where
    if [[ ! -d $main/.git || -L $main/.git ]]; then
        echo "$(ws_shown "$main") is not a git checkout"
    elif [[ -e $wt || -L $wt ]]; then
        echo "$(ws_shown "$wt") exists and is not a worktree of $(ws_shown "$main") on $3"
    elif where=$(ticket_checked_out "$main" "$3"); then
        echo "$3 is checked out in $(ws_shown "$where")"
    fi
}

ticket_wt_add() {
    local wt=$1/$2 repo=$2 branch=$3 main=$WS_PROJECTS/$2 base from
    if git -C "$main" remote get-url origin >/dev/null 2>&1 &&
        ! GIT_TERMINAL_PROMPT=0 timeout -k 5 60 git -C "$main" fetch -q origin </dev/null; then
        echo "ws: cannot fetch origin of $repo, so $branch starts from what $(ws_shown "$main") has" >&2
    fi
    if git -C "$main" show-ref --verify -q "refs/heads/$branch"; then
        git -C "$main" worktree add -q "$wt" "$branch" </dev/null || return 1
        from="the existing branch"
    elif git -C "$main" show-ref --verify -q "refs/remotes/origin/$branch"; then
        git -C "$main" worktree add -q --track -b "$branch" "$wt" "origin/$branch" </dev/null || return 1
        from="tracking origin/$branch"
    else
        base=$(git -C "$main" symbolic-ref -q --short refs/remotes/origin/HEAD) || base=HEAD
        git -C "$main" worktree add -q --no-track -b "$branch" "$wt" "$base" </dev/null || return 1
        from="a new branch from $base"
    fi
    echo "Made $(ws_shown "$wt"), $from"
}

ticket_claude_text() {
    local id=$1 branch=$2 note=$3 repo
    shift 3
    echo "# Ticket $id"
    echo
    echo "$note"
    echo
    echo "- Each repo directory here is a git worktree on branch \`$branch\`."
    for repo; do
        echo "  - \`$repo/\` belongs to \`$(ws_shown "$WS_PROJECTS/$repo")\`."
    done
    echo "- \`.ws\` holds the ticket state, and only ws writes it. Run \`ws stage <stage>\` here to move the ticket on."
    echo "- Log progress with \`$(ws_shown "$WS_VAULT/bin/vault-log") $id \"<what changed>\"\`."
}

ticket_claude_env() {
    local pair
    local -a pairs=()
    local -A kv=()
    ticket_read "$1" kv "$2" || true
    read -r -a pairs <<<"${kv[WS_URLS]-}"
    if ((${#pairs[@]})); then
        echo "The dockyard env runs on slot ${kv[WS_SLOT]:-?}. \`ws down\` stops it and keeps the slot."
        echo
        for pair in "${pairs[@]}"; do
            echo "- ${pair%%=*}: ${pair#*=}"
        done
    elif [[ -n ${kv[WS_SLOT]-} ]]; then
        echo "The dockyard env is down and keeps slot ${kv[WS_SLOT]}. \`ws up\` starts it again."
    else
        echo "No dockyard env runs for this ticket. \`ws up\` starts one."
    fi
}

ticket_claude_block() {
    printf '%s\n\n## Env\n\n%s\n' "$1" "$WS_ENV_START"
    [[ -z $2 ]] || printf '%s\n' "$2"
    printf '%s\n' "$WS_ENV_END"
}

ticket_claude_swap() {
    LC_ALL=C WS_FROM=$WS_ENV_START WS_TO=$WS_ENV_END WS_LINES=$2 awk '
        $0 == ENVIRON["WS_FROM"] { from = from ? -1 : NR }
        $0 == ENVIRON["WS_TO"] { to = to ? -1 : NR }
        { line[NR] = $0 }
        END {
            if (from < 1 || to <= from) exit 1
            for (i = 1; i <= NR; i++) {
                if (i <= from || i >= to) print line[i]
                if (i == from && ENVIRON["WS_LINES"] != "") print ENVIRON["WS_LINES"]
            }
        }' "$1"
}

ticket_claude_md() {
    ticket_locked "$1" ticket_claude_rewrite "$@"
}

ticket_claude_rewrite() {
    local dir=$1 id=$2 branch=$3 file=$1/CLAUDE.md header env note note_2_0_66 tmp edited=0
    local -a old=()
    read -r -a old <<<"$4"
    shift 4
    note="ws wrote this file. It imports no other file. \`ws new $id\` writes it again until you edit it."
    env=$(ticket_claude_env "$dir" "$id")
    if [[ -e $file || -L $file ]]; then
        [[ -f $file && -r $file && ! -L $file ]] || return 0
        header=$(ticket_claude_text "$id" "$branch" "$note" "${old[@]}")
        note_2_0_66="ws wrote this file and writes it again on each \`ws new $id\`. It imports no other file."
        if ! printf '%s\n' "$header" | cmp -s -- "$file" - &&
            ! ticket_claude_text "$id" "$branch" "$note_2_0_66" "${old[@]}" | cmp -s -- "$file" - &&
            ! ticket_claude_block "$header" "" | cmp -s - <(ticket_claude_swap "$file" ""); then
            edited=1
        fi
    fi
    tmp=$(mktemp -- "$dir/.CLAUDE.md.XXXXXX") || return 1
    if ((edited)); then
        if ! ticket_claude_swap "$file" "$env" >"$tmp"; then
            rm -f -- "$tmp"
            echo "ws: $(ws_shown "$file") does not hold exactly one env block, so ws leaves it as it is" >&2
            return 0
        fi
    elif ! ticket_claude_block "$(ticket_claude_text "$id" "$branch" "$note" "$@")" "$env" >"$tmp"; then
        rm -f -- "$tmp"
        return 1
    fi
    ws_write_in_place "$file" "$tmp"
}

ticket_claude_refresh() {
    local -a repos=()
    local -A kv=()
    ticket_read "$1" kv || return 1
    read -r -a repos <<<"${kv[WS_REPOS]-}"
    ticket_claude_md "$1" "${kv[WS_ID]}" "${kv[WS_BRANCH]-}" "${kv[WS_REPOS]-}" "${repos[@]}"
}

ticket_stack_name() {
    local s=$1 LC_ALL=C
    [[ ! $s =~ ^(feature|fix|hotfix|release)/(.*)$ ]] || s=${BASH_REMATCH[2]}
    s=${s,,}
    s=${s//[^a-z0-9-]/-}
    while [[ $s == *--* ]]; do
        s=${s//--/-}
    done
    s=${s#-}
    printf '%s\n' "${s%-}"
}

ticket_env() {
    local file=$HOME/.dockyard/slots.json row workspace holder
    local -n te=$1
    te=(["stack"]="$(ticket_stack_name "$3")" ["slot"]="" ["other"]="")
    te["project"]="dockyard-${te["stack"]}"
    [[ -n ${te["stack"]} && -f $file ]] || return 0
    if ! row=$(jq -r --arg s "${te["stack"]}" '.[$s] // empty | "\(.slot)\t\(.workspace // "")"' "$file" 2>/dev/null) ||
        [[ -n $row && ! $row =~ ^[0-9]+$'\t' ]]; then
        echo "ws: cannot read the record of dockyard stack ${te["stack"]} in $(ws_shown "$file")" >&2
        return 1
    fi
    [[ -n $row ]] || return 0
    workspace=${row#*$'\t'}
    if [[ -n $workspace && ($workspace == "$2" || $workspace -ef $2) ]]; then
        te["slot"]=${row%%$'\t'*}
    elif [[ -n $workspace ]] && holder=$(ticket_of_path "$(realpath -m -- "$workspace")"); then
        te["other"]="ticket $holder in $(ws_shown "$workspace")"
    elif [[ -n $workspace ]]; then
        te["other"]="the workspace $(ws_shown "$workspace")"
    else
        te["other"]="no workspace"
    fi
}

ticket_env_running() {
    local ids
    ids=$(docker ps -q --filter "label=com.docker.compose.project=$1" --filter status=running 2>/dev/null) &&
        [[ -n $ids ]]
}

ticket_dockyard_out() {
    local line LC_ALL=C color=$'\e\\[[0-9;]*m' stack_re='\(slug: ([a-z0-9-]+)\)$'
    local url_re='^[[:space:]]+([A-Za-z][A-Za-z0-9 ]*[A-Za-z0-9]):[[:space:]]+(https?://[^[:space:]]+)$'
    local -a urls=()
    local -n to=$2
    to=(["stack"]="")
    while IFS= read -r line; do
        while [[ $line =~ $color ]]; do
            line=${line/"${BASH_REMATCH[0]}"/}
        done
        if [[ -z ${to["stack"]} && $line =~ $stack_re ]]; then
            to["stack"]=${BASH_REMATCH[1]}
        elif [[ $line =~ $url_re ]]; then
            line=${BASH_REMATCH[1],,}
            urls+=("${line// /-}=${BASH_REMATCH[2]}")
        fi
    done <"$1"
    to["urls"]=${urls[*]}
}

ticket_env_down() {
    local rc=0
    if [[ -n $3 ]]; then
        dockyard down "$2" </dev/null || rc=$?
        if ((rc)) && ticket_env_running "$4"; then
            echo "ws: dockyard down $2 failed with status $rc" >&2
            return "$rc"
        elif ((rc)); then
            echo "ws: dockyard down $2 failed with status $rc, and no container of the stack runs" >&2
        fi
    fi
    ticket_update "$1" set WS_SLOT "$3" WS_URLS "" || return 1
    ticket_claude_refresh "$1" || echo "ws: cannot write $(ws_shown "$1/CLAUDE.md")" >&2
}

ticket_pane_idle() {
    local procs shell=${SHELL-}
    [[ $1 =~ ^[0-9]+$ && $2 == /dev/?* && " bash zsh sh dash fish ksh tcsh ${shell##*/} " == *" $3 "* ]] || return 1
    procs=$(ps -o pid= -t "${2#/dev/}" 2>/dev/null)
    [[ ${procs//[[:space:]]/} == "$1" ]]
}

ticket_env_logs() {
    local path win mine pane="" panes="" pid="" tty="" mode="" cmd="" start="" var
    local -a opts=() tail=(docker compose -p "$3" logs --follow --tail 50)
    path=$(ticket_session_path "$1") && [[ $(realpath -m -- "$path") == "$(realpath -m -- "$2")" ]] || return 0
    win=$(tmux list-windows -t "=$1:" -F '#{window_id} #{window_name}' | sed -n 's/^\(@[0-9]*\) env$/\1/p')
    if [[ -z $win ]]; then
        pane=$(tmux new-window -d -a -t "=$1:{end}" -n env -c "$2" -P -F '#{pane_id}') || return 1
    else
        if [[ $win != *$'\n'* ]]; then
            IFS='|' read -r pane panes pid tty mode cmd start < <(tmux display-message -p -t "$win" \
                '#{pane_id}|#{window_panes}|#{pane_pid}|#{pane_tty}|#{pane_in_mode}|#{pane_current_command}|#{pane_start_command}')
        fi
        mine=$(ps -o tty= -p "$$" 2>/dev/null) || mine=
        if [[ -n $tty && /dev/${mine// /} == "$tty" ]] ||
            [[ -n ${TMUX_PANE-} && $(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null) == "$win" ]]; then
            echo "ws runs in the env window, so it leaves the window. Tail the logs with: ${tail[*]}"
            return 0
        fi
        if [[ $panes != 1 || $mode != 0 ]] || ! { [[ $start == "${tail[*]}" ]] || ticket_pane_idle "$pid" "$tty" "$cmd"; }; then
            echo "The env window of $1 is in use, so ws leaves it. Tail the logs with: ${tail[*]}"
            return 0
        fi
    fi
    for var in DOCKER_HOST DOCKER_CONTEXT; do
        [[ -z ${!var-} ]] || opts+=(-e "$var=${!var}")
    done
    tmux set-option -p -t "$pane" remain-on-exit on &&
        tmux respawn-pane -k -t "$pane" -c "$2" "${opts[@]}" "${tail[@]}"
}

ticket_env_wait() {
    local pair code now deadline max
    local -a left=() next=()
    read -r -a left <<<"$1"
    printf -v now '%(%s)T' -1
    deadline=$((now + 10#$WS_UP_TIMEOUT))
    while ((${#left[@]})); do
        next=()
        for pair in "${left[@]}"; do
            printf -v now '%(%s)T' -1
            max=$((deadline - now))
            ((max <= 5)) || max=5
            ((max >= 1)) || max=1
            code=$(curl -s -o /dev/null -m "$max" -w '%{http_code}' -- "${pair#*=}" </dev/null) || true
            if [[ $code =~ ^[1-4][0-9][0-9]$ ]]; then
                echo "${pair%%=*} ${pair#*=} ready"
            else
                next+=("$pair")
            fi
        done
        left=("${next[@]}")
        ((${#left[@]})) || break
        printf -v now '%(%s)T' -1
        if ((now >= deadline)); then
            for pair in "${left[@]}"; do
                echo "ws: ${pair%%=*} ${pair#*=} gave no HTTP answer below 500 in $WS_UP_TIMEOUT seconds" >&2
            done
            return 1
        fi
        sleep 2
    done
}

# A tmux server keeps the working directory of the client that started it.
ws_new_session() {
    (cd / && tmux new-session -d "$@")
}

ticket_session_path() {
    tmux has-session -t "=$1:" 2>/dev/null || return 1
    tmux display-message -p -t "=$1:" '#{session_path}' 2>/dev/null || true
}

ticket_session_foreign() {
    local path
    path=$(ticket_session_path "$1") || return 1
    [[ $(realpath -m -- "$path") != "$(realpath -m -- "$2")" ]] || return 1
    echo "tmux session $1 works in $(ws_shown "$path"), not $(ws_shown "$2")"
}

ticket_session() {
    local id=$1 dir=$2 why
    local -a have=()
    if why=$(ticket_session_foreign "$id" "$dir"); then
        echo "ws: $why" >&2
        return 1
    fi
    if ! tmux has-session -t "=$id:" 2>/dev/null; then
        ws_new_session -s "$id" -c "$dir" -n shell || return 1
    fi
    mapfile -t have < <(tmux list-windows -t "=$id:" -F '#{window_name}')
    if [[ " ${have[*]} " != *" claude "* ]]; then
        tmux new-window -d -b -t "=$id:{start}" -n claude -c "$dir" claude -n "$id" || return 1
        tmux select-window -t "=$id:claude" || true
    fi
    if [[ " ${have[*]} " != *" shell "* ]]; then
        tmux new-window -d -a -t "=$id:{end}" -n shell -c "$dir" || return 1
    fi
    if [[ " ${have[*]} " != *" env "* ]]; then
        tmux new-window -d -a -t "=$id:{end}" -n env -c "$dir" || return 1
    fi
}

ws_switch() {
    if [[ -n ${TMUX-} ]]; then
        tmux switch-client -t "=$1:"
    elif [[ -t 0 && -t 1 ]]; then
        tmux attach-session -t "=$1:"
    else
        echo "Attach with: tmux attach -t '=$1:'"
    fi
}

ticket_check() {
    local id=$1 branch=$2 arriving=" $3 " dir=$WS_ROOT/$1 repo why fail=0
    local -A kv=() seen=()
    shift 3
    TICKET_OLD=() TICKET_REPOS=() TICKET_ADD=()
    ticket_check_id "$id" || return 1
    if ! ticket_branch_ok "$branch"; then
        echo "ws: '$branch' is not a branch name ws takes" >&2
        return 1
    fi
    if [[ -L $dir || (-e $dir && ! -d $dir) ]]; then
        echo "ws: $(ws_shown "$dir") is not a directory" >&2
        return 1
    fi
    if [[ -e $dir/.ws || -L $dir/.ws ]]; then
        if ! ticket_read "$dir" kv; then
            echo "ws: $REPLY" >&2
            return 1
        fi
        if [[ -n ${kv[WS_BRANCH]-} && ${kv[WS_BRANCH]} != "$branch" ]]; then
            echo "ws: ticket $id is on branch ${kv[WS_BRANCH]}, not $branch" >&2
            return 1
        fi
        read -r -a TICKET_OLD <<<"${kv[WS_REPOS]-}"
    fi
    for repo in "${TICKET_OLD[@]}" "$@"; do
        if ! ticket_name_ok "$repo"; then
            echo "ws: '$repo' is not a repo name" >&2
            fail=1
            continue
        fi
        [[ -z ${seen[$repo]+set} ]] || continue
        seen[$repo]=1
        TICKET_REPOS+=("$repo")
        if [[ $arriving == *" $repo "* ]] || ticket_wt_ready "$dir" "$repo" "$branch"; then
            continue
        fi
        why=$(ticket_wt_blocker "$dir" "$repo" "$branch")
        if [[ -n $why ]]; then
            echo "ws: $why" >&2
            fail=1
        else
            TICKET_ADD+=("$repo")
        fi
    done
    if why=$(ticket_session_foreign "$id" "$dir"); then
        echo "ws: $why" >&2
        fail=1
    fi
    ((fail == 0))
}

ticket_scenarios_file() {
    local -n tsf=$1
    printf '%s\n' "$WS_VAULT/projects/work/${tsf[WS_TOPIC]:-${tsf[WS_ID]}}/scenarios/${tsf[WS_ID]}.md"
}

ticket_evidence_root() {
    local -n ter=$1
    printf '%s\n' "$WS_VAULT/projects/work/${ter[WS_TOPIC]:-${ter[WS_ID]}}/evidence/${ter[WS_ID]}"
}

# Claude Code reads //path as an absolute path. An Edit rule also denies its Write tool and the shell writes
# that it parses, such as redirects, cp, tee, and sed -i, but not a write by any other program.
edit_deny_rules() {
    local -n edr=$1
    local p path
    shift
    edr=()
    for p; do
        path=$(realpath -m -- "${p%/\*\*}")
        if [[ $path == *[][*?\\]* ]]; then
            echo "ws: $(ws_shown "$path") holds a character that Claude Code reads as a pattern, so ws writes no deny rule for it" >&2
            return 1
        fi
        [[ $p != */\*\* ]] || path+='/**'
        edr+=("Edit(/$path)")
    done
}

ticket_deny() {
    local dir=$1/.claude file=$1/.claude/settings.json tmp
    shift
    if [[ -L $dir || -L $file || (-e $file && ! -f $file) ]]; then
        echo "ws: $(ws_shown "$file") is not a plain file, so ws adds no deny rules to it" >&2
        return 1
    fi
    mkdir -p -- "$dir" || return 1
    tmp=$(mktemp -- "$dir/.settings.json.XXXXXX") || return 1
    if [[ -s $file ]]; then
        jq '.permissions.deny |= ((. // []) | . + ($ARGS.positional - .))' "$file" --args "$@" >"$tmp" 2>/dev/null
    else
        jq -n '{permissions: {deny: $ARGS.positional}}' --args "$@" >"$tmp"
    fi || {
        rm -f -- "$tmp"
        echo "ws: $(ws_shown "$file") does not hold a settings object with a permissions.deny list, so ws adds no deny rules to it" >&2
        return 1
    }
    ws_write_in_place "$file" "$tmp"
}

ticket_make() {
    local id=$1 branch=$2 ticket=$3 topic=$4 dir=$WS_ROOT/$1 repo fail=0
    local -a extra=() rules=()
    local -A kv=()
    shift 4
    ticket_check "$id" "$branch" "" "$@" || return 1

    mkdir -p -- "$dir" || return 1
    [[ -z $ticket ]] || extra+=(WS_TICKET "$ticket")
    [[ -z $topic ]] || extra+=(WS_TOPIC "$topic")
    ticket_update "$dir" set WS_ID "$id" WS_BRANCH "$branch" WS_REPOS "${TICKET_REPOS[*]}" "${extra[@]}" \
        default WS_TOPIC "$id" WS_STAGE spec WS_CREATED "$(date +%F)" || return 1
    for repo in "${TICKET_ADD[@]}"; do
        ticket_wt_add "$dir" "$repo" "$branch" || fail=1
    done
    ticket_claude_md "$dir" "$id" "$branch" "${TICKET_OLD[*]}" "${TICKET_REPOS[@]}" || fail=1
    if ! ticket_read "$dir" kv ||
        ! edit_deny_rules rules "$(ticket_scenarios_file kv)" "$dir/.ws" "$(ticket_evidence_root kv)/**" ||
        ! ticket_locked "$dir" ticket_deny "$dir" "${rules[@]}"; then
        fail=1
    fi
    ticket_session "$id" "$dir" || return 1
    ((fail == 0)) || return 1
    ws_switch "$id"
}

ws_new() {
    local ticket="" topic=""
    while (($#)); do
        case $1 in
        --ticket | --topic)
            if (($# < 2)) || ! ticket_name_ok "$2"; then
                echo "ws: $1 takes a plain ASCII name: letters, digits, dots, dashes, and underscores" >&2
                return 1
            fi
            if [[ $1 == --ticket ]]; then ticket=$2; else topic=$2; fi
            shift 2
            ;;
        -h | --help)
            ticket_usage
            return 0
            ;;
        -*)
            ticket_usage >&2
            return 1
            ;;
        *) break ;;
        esac
    done
    if (($# < 3)); then
        ticket_usage >&2
        return 1
    fi
    ticket_make "$1" "$2" "$ticket" "$topic" "${@:3}"
}

ticket_adopt_blocker() {
    local why
    why=$(ws_fact "$1" unreadable) && {
        echo "ws cannot read it: $(ws_detail "$why")"
        return
    }
    why=$(ws_fact "$1" container) && {
        echo "$(ws_detail "$why") mounts it"
        return
    }
    if [[ $(ws_fact "$1" in-use) != 0 ]]; then
        echo "a process works in it"
    elif [[ $(ws_fact "$1" locked) != 0 ]]; then
        echo "it is locked"
    elif [[ $(ws_fact "$1" submodules) != 0 ]]; then
        echo "it has submodules, which git worktree move cannot move"
    elif [[ -z $(ws_fact "$1" branch) ]]; then
        echo "its HEAD is detached"
    fi
}

ws_adopt() {
    local id dir real d why main repo owner branch="" i fail=0
    local -a reals=() commons=() repos=() branches=()
    local -A seen=()
    case ${1-} in
    -h | --help)
        ticket_usage
        return 0
        ;;
    esac
    if (($# < 2)); then
        ticket_usage >&2
        return 1
    fi
    id=$1
    shift
    ticket_check_id "$id" || return 1
    WS_TRASH=$(realpath -m -- "$WS_TRASH") || return 1
    ws_env_ok || return 1
    ws_engine_mounts
    d=$(mktemp -d) || return 1
    for dir; do
        if ! real=$(realpath -e -- "$dir" 2>/dev/null) || [[ ! -d $real ]]; then
            echo "ws: $dir is not a directory" >&2
            fail=1
            continue
        fi
        if [[ ! -f $real/.git || -L $real/.git ]]; then
            echo "ws: $(ws_shown "$real") is not a linked worktree" >&2
            fail=1
            continue
        fi
        if owner=$(ticket_of_path "$real") && [[ $owner != "$id" ]]; then
            echo "ws: $(ws_shown "$real") belongs to ticket $owner" >&2
            fail=1
            continue
        fi
        ws_wt_facts "$real" >"$d/facts" 2>/dev/null
        why=$(ticket_adopt_blocker "$d/facts")
        if [[ -n $why ]]; then
            echo "ws: $(ws_shown "$real"): $why" >&2
            fail=1
            continue
        fi
        main=$(ws_decode "$(ws_fact "$d/facts" main)")
        repo=${main##*/}
        if ! ticket_name_ok "$repo" || [[ $(realpath -m -- "$WS_PROJECTS/$repo") != "$(realpath -m -- "$main")" ]]; then
            echo "ws: $(ws_shown "$real") belongs to $(ws_shown "$main"), which is not a repo in $(ws_shown "$WS_PROJECTS")" >&2
            fail=1
            continue
        fi
        if [[ -n ${seen[$repo]+set} ]]; then
            echo "ws: $(ws_shown "$real") and $(ws_shown "${seen[$repo]}") are both worktrees of $repo" >&2
            fail=1
            continue
        fi
        if [[ -e $WS_ROOT/$id/$repo || -L $WS_ROOT/$id/$repo ]]; then
            echo "ws: $(ws_shown "$WS_ROOT/$id/$repo") exists" >&2
            fail=1
            continue
        fi
        seen[$repo]=$real
        reals+=("$real")
        commons+=("$(ws_decode "$(ws_fact "$d/facts" common)")")
        repos+=("$repo")
        branches+=("$(ws_decode "$(ws_fact "$d/facts" branch)")")
    done
    rm -rf -- "$d"
    for i in "${!branches[@]}"; do
        [[ -n $branch ]] || branch=${branches[i]}
        if [[ ${branches[i]} != "$branch" ]]; then
            echo "ws: the worktrees are on different branches: $branch and ${branches[i]}" >&2
            fail=1
            break
        fi
    done
    if ((${#reals[@]})) && ! ticket_check "$id" "$branch" "${repos[*]}" "${repos[@]}"; then
        fail=1
    fi
    ((fail == 0)) || return 1

    mkdir -p -- "$WS_ROOT/$id" || return 1
    for i in "${!reals[@]}"; do
        if ! ws_move "${commons[i]}" "${reals[i]}" "$WS_ROOT/$id/${repos[i]}"; then
            echo "ws: stopped; run ws adopt $id again with the worktrees that did not move" >&2
            return 1
        fi
        echo "Moved $(ws_shown "${reals[i]}") to $(ws_shown "$WS_ROOT/$id/${repos[i]}")"
    done
    ticket_make "$id" "$branch" "" "" "${repos[@]}"
}

status_read() {
    local kind a b
    S_CWD=() S_WAIT=() P_STATES=()
    [[ -f $WS_CACHE_DIR/status.json ]] || return 0
    while IFS=$'\t' read -r kind a b; do
        case $kind in
        S)
            S_WAIT+=("$a")
            S_CWD+=("$b")
            ;;
        P) P_STATES[$a]=$b ;;
        esac
    done < <(jq -r '
        ((.claude.sessions // []) | if type == "array" then .[] else empty end
            | select(type == "object" and (.cwd | type) == "string" and (.cwd | test("[\t\n]") | not))
            | "S\t\(if .waiting == true then 1 else 0 end)\t\(.cwd)"),
        ((.prs.tickets // {}) | if type == "object" then to_entries[] else empty end
            | select((.key | test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and (.value | type) == "array")
            | "P\t\(.key)\t\(.value | map(strings | select(test("^[a-z-]+$"))) | join(","))")' \
        "$WS_CACHE_DIR/status.json" 2>/dev/null)
}

status_prs() {
    local now=$1 d id repo common line key state
    local -a repos=()
    local -A ids_of=()
    d=$(mktemp -d) || return 1
    ticket_scan
    for id in "${T_IDS[@]}"; do
        [[ -z ${T_BAD[$id]+set} && -n ${T_BRANCH[$id]} ]] || continue
        read -r -a repos <<<"${T_REPOS[$id]}"
        for repo in "${repos[@]}"; do
            ticket_name_ok "$repo" || continue
            common=$(git -C "$WS_PROJECTS/$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || continue
            line=$(ws_record common "$common" branch "${T_BRANCH[$id]}")
            [[ -n ${ids_of[$line]+set} ]] || printf '%s\n' "$line" >>"$d/want"
            ids_of[$line]+=" $id"
        done
    done
    : >"$d/states"
    if [[ -s $d/want ]]; then
        ws_pr_states --head <"$d/want" >"$d/prs" || true
        while IFS= read -r line; do
            [[ $line == pr$'\t'* ]] || continue
            key=$(printf 'common=%s\tbranch=%s' "$(ws_get "$line" common)" "$(ws_get "$line" branch)")
            state=$(ws_get "$line" state) || continue
            for id in ${ids_of[$key]-}; do
                printf '%s\t%s\n' "$id" "$state" >>"$d/states"
            done
        done <"$d/prs"
    fi
    jq -cRn --argjson now "$now" '
        def rank: {open: 0, merged: 1, closed: 2, "no-pr": 3}[.] // 4;
        {time: $now, tickets: ([inputs | split("\t")] | group_by(.[0])
            | map({key: .[0][0], value: (map(.[1]) | unique | sort_by(rank))}) | from_entries)}' <"$d/states"
    rm -rf -- "$d"
}

status_refresh() {
    local fd now out sessions=null prs="" old_time="" failed="" ttl tmp id
    local -a ids=()
    if ! [[ $WS_PR_TTL =~ ^[0-9]+$ ]]; then
        echo "ws: WS_PR_TTL must be a number of seconds" >&2
        return 1
    fi
    [[ -d $HOME ]] || return 1
    mkdir -p -- "$WS_CACHE_DIR" || return 1
    if [[ ${WS_HELD_LOCK_FD-} =~ ^[0-9]+$ ]] && { : >&"$WS_HELD_LOCK_FD"; } 2>/dev/null; then
        fd=$WS_HELD_LOCK_FD
    else
        exec {fd}>>"$WS_CACHE_DIR/refresh.lock" || return 1
    fi
    if ! flock -w 60 "$fd"; then
        echo "ws: another status refresh held the lock for 60 seconds" >&2
        return 1
    fi
    printf -v now '%(%s)T' -1
    if out=$(timeout -k 2 10 claude agents --json </dev/null 2>/dev/null); then
        sessions=$(jq -c 'if type == "array" then [.[] | select(type == "object" and (.cwd | type) == "string")
            | {cwd, waiting: (.status == "waiting" or .state == "blocked")}] else error("not a list") end' \
            <<<"$out" 2>/dev/null) || sessions=null
    fi
    read -r old_time failed < <(jq -r '.prs | select(type == "object" and (.tickets | type) == "object")
        | "\(.time | numbers | floor) \([.tickets[] | arrays | index("failed")] | any)"' \
        "$WS_CACHE_DIR/status.json" 2>/dev/null) || true
    ttl=$WS_PR_TTL
    [[ $failed != true ]] || ((ttl < WS_PR_FAILED_TTL)) || ttl=$WS_PR_FAILED_TTL
    if [[ $old_time =~ ^[0-9]+$ ]] && ((now - old_time < ttl)); then
        ticket_scan
        for id in "${T_IDS[@]}"; do
            [[ -n ${T_BAD[$id]+set} || -z ${T_BRANCH[$id]} ]] || ids+=("$id")
        done
        prs=$(jq -c '.prs as $p | if all($ARGS.positional[]; . as $id | $p.tickets | has($id)) then $p else empty end' \
            --args "${ids[@]}" <"$WS_CACHE_DIR/status.json" 2>/dev/null) || prs=
    fi
    [[ -n $prs ]] || prs=$(status_prs "$now") || prs=null
    tmp=$(mktemp -- "$WS_CACHE_DIR/.status.XXXXXX") || return 1
    if jq -n --argjson now "$now" --argjson sessions "${sessions:-null}" --argjson prs "${prs:-null}" \
        '{claude: {time: $now, sessions: $sessions}, prs: $prs}' >"$tmp" && mv -T -- "$tmp" "$WS_CACHE_DIR/status.json"; then
        return 0
    fi
    rm -f -- "$tmp"
    return 1
}

status_refresh_bg() {
    local fd self
    if [[ ! -d $HOME ]] || ! mkdir -p -- "$WS_CACHE_DIR" 2>/dev/null; then
        return 0
    fi
    { exec {fd}>>"$WS_CACHE_DIR/refresh.lock"; } 2>/dev/null || return 0
    if flock -n "$fd" && self=$(realpath -e -- "${BASH_SOURCE[0]}"); then
        WS_HELD_LOCK_FD=$fd setsid -f bash "$self" status --refresh </dev/null >/dev/null 2>&1 || true
    fi
    exec {fd}>&-
}

ws_status() {
    local n=0 w
    case "$#:${1-}" in
    1:--refresh) status_refresh ;;
    1:--waiting)
        status_read
        for w in "${S_WAIT[@]}"; do
            ((w != 1)) || n=$((n + 1))
        done
        ((n == 0)) || echo "$n waiting"
        status_refresh_bg
        ;;
    0:)
        status_refresh || return 1
        ticket_list
        ;;
    1:-h | 1:--help) ticket_usage ;;
    *)
        ticket_usage >&2
        return 1
        ;;
    esac
}

pick_build() {
    local id dir i n best len stage idx rank waiting pr env text
    local -a rows=() more=() reals=() order=()
    local -A seen=() wait_of=() stage_rank=()
    R_PATH=() R_TEXT=()
    n=0
    for stage in $WS_STAGES; do
        stage_rank[$stage]=$((n++))
    done
    ticket_scan
    status_read
    for id in "${T_IDS[@]}"; do
        rows+=("$WS_ROOT/$id")
    done
    mapfile -d '' more < <(find -H "$WS_PROJECTS" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | LC_ALL=C sort -z)
    [[ ! -d $WS_VAULT ]] || more+=("$WS_VAULT")
    for dir in "${T_PLAIN[@]}" "${more[@]}"; do
        [[ $dir != *[$'\t\n']* && -z ${seen[$dir]+set} ]] || continue
        seen[$dir]=1
        rows+=("$dir")
    done
    if ((${#rows[@]} && ${#S_CWD[@]})); then
        mapfile -d '' reals < <(realpath -m -z -- "${rows[@]}")
        for i in "${!S_CWD[@]}"; do
            [[ ${S_WAIT[i]} == 1 ]] || continue
            best=-1 len=0
            for n in "${!reals[@]}"; do
                if [[ ${S_CWD[i]} == "${reals[n]}" || ${S_CWD[i]} == "${reals[n]}"/* ]] && ((${#reals[n]} > len)); then
                    best=$n len=${#reals[n]}
                fi
            done
            ((best < 0)) || wait_of[$best]=$((${wait_of[$best]:-0} + 1))
        done
    fi

    mapfile -t order < <(
        for i in "${!T_IDS[@]}"; do
            id=${T_IDS[i]}
            stage=${T_STAGE[$id]-}
            idx=9
            [[ -z $stage || -z ${stage_rank[$stage]+set} ]] || idx=${stage_rank[$stage]}
            rank=2
            if [[ -n ${T_BAD[$id]+set} ]]; then
                rank=3
            elif ((${wait_of[$i]:-0})); then
                rank=0
            elif [[ -n $stage && " $WS_OPERATOR_STAGES " == *" $stage "* ]]; then
                rank=1
            fi
            printf '%s\t%s\t%s\t%s\n' "$rank" "$idx" "$id" "$i"
        done | LC_ALL=C sort -t $'\t' -k1,1n -k2,2n -k3,3 | cut -f4
    )
    for i in "${order[@]}"; do
        id=${T_IDS[i]}
        waiting=
        ((${wait_of[$i]:-0} == 0)) || waiting="${wait_of[$i]} waiting"
        if [[ -n ${T_BAD[$id]+set} ]]; then
            printf -v text '%-16s %s' "$id" "malformed .ws: ${T_BAD[$id]}"
        else
            pr=${P_STATES[$id]:+pr:${P_STATES[$id]}}
            env=${T_ENV[$id]:+env:${T_ENV[$id]}}
            printf -v text '%-16s %-10s %-10s %-16s %-9s %s' "$id" "${T_STAGE[$id]:-?}" "$waiting" "$pr" "$env" \
                "${T_BRANCH[$id]}"
            text=${text%"${text##*[! ]}"}
        fi
        R_PATH+=("${rows[i]}")
        R_TEXT+=("$text")
    done
    for ((i = ${#T_IDS[@]}; i < ${#rows[@]}; i++)); do
        text=${rows[i]/#"$HOME/"/\~/}
        ((${wait_of[$i]:-0} == 0)) || text+="  ${wait_of[$i]} waiting"
        R_PATH+=("${rows[i]}")
        R_TEXT+=("$text")
    done
}

pick_print() {
    local i
    pick_build
    for i in "${!R_PATH[@]}"; do
        printf '%s\t%s\n' "${R_PATH[i]}" "${R_TEXT[i]}"
    done
}

ticket_list() {
    local i
    pick_build
    if ((${#T_IDS[@]} == 0)); then
        echo "No tickets in $(ws_shown "$WS_ROOT")"
    fi
    for ((i = 0; i < ${#T_IDS[@]}; i++)); do
        printf '%s\n' "${R_TEXT[i]}"
    done
}

pick_open() {
    local path=$1 name f
    local -A kv=()
    if [[ $path == "$WS_ROOT"/* && ${path#"$WS_ROOT"/} != */* && -e $path/.ws ]]; then
        if ! ticket_read "$path" kv; then
            echo "ws: $REPLY" >&2
            return 1
        fi
        ticket_session "${kv[WS_ID]}" "$path" || return 1
        ws_switch "${kv[WS_ID]}"
        return
    fi
    name=${path##*/}
    name=${name//./_}
    if ! tmux has-session -t "=$name:" 2>/dev/null; then
        ws_new_session -s "$name" -c "$path" || return 1
        for f in "$path/.tmux-ready" "$HOME/.tmux-ready"; do
            if [[ -f $f ]]; then
                tmux send-keys -t "=$name:" "source $(printf %q "$f")" C-m
                break
            fi
        done
    fi
    ws_switch "$name"
}

ws_pick() {
    local sel out
    case "$#:${1-}" in
    1:--print)
        pick_print
        return
        ;;
    1:-h | 1:--help)
        ticket_usage
        return 0
        ;;
    0:) ;;
    *)
        ticket_usage >&2
        return 1
        ;;
    esac
    if ! command -v fzf >/dev/null; then
        echo "ws: fzf is not installed" >&2
        return 1
    fi
    status_refresh_bg
    sel=$(pick_print | fzf --delimiter=$'\t' --with-nth=2.. --tiebreak=index --prompt='ws> ') || return 0
    if [[ -n ${TMUX-} ]]; then
        if ! out=$(pick_open "${sel%%$'\t'*}" 2>&1); then
            tmux display-message -- "${out:-ws: cannot open ${sel%%$'\t'*}}"
            return 1
        fi
    else
        pick_open "${sel%%$'\t'*}"
    fi
}

ws_ls() {
    case "$#:${1-}" in
    0:) ticket_list ;;
    1:-h | 1:--help) ticket_usage ;;
    *)
        ticket_usage >&2
        return 1
        ;;
    esac
}

ws_stage() {
    local stage dir id n=0
    case "$#:${1-}" in
    1:-h | 1:--help)
        ticket_usage
        return 0
        ;;
    1:*)
        stage=$1
        dir=$(ticket_here "ws stage <id> <stage>") || return 1
        ;;
    2:*)
        ticket_check_id "$1" || return 1
        dir=$WS_ROOT/$1
        stage=$2
        ;;
    *)
        ticket_usage >&2
        return 1
        ;;
    esac
    if [[ " $WS_STAGES " != *" $stage "* ]]; then
        echo "ws: the stage must be one of: $WS_STAGES" >&2
        return 1
    fi
    if [[ -L $dir || ! -d $dir || ! -e $dir/.ws ]]; then
        echo "ws: no ticket $(ws_shown "$dir")" >&2
        return 1
    fi
    ticket_update "$dir" set WS_STAGE "$stage" || return 1
    echo "${dir##*/} is at $stage"
    [[ $stage == building ]] || return 0
    ticket_scan
    for id in "${T_IDS[@]}"; do
        [[ ${T_STAGE[$id]-} != building ]] || n=$((n + 1))
    done
    if ((n > WS_BUILDING_LIMIT)); then
        echo "ws: $n tickets are in building, more than $WS_BUILDING_LIMIT. Finish one before you start another." >&2
    fi
}

ws_up() {
    local wait=0 dir real id branch out rc=0 urls pair why=""
    local -a pairs=() ids=()
    local -A kv=() env=() said=()
    while (($#)); do
        case $1 in
        --wait) wait=1 ;;
        -h | --help)
            ticket_usage
            return 0
            ;;
        -*)
            ticket_usage >&2
            return 1
            ;;
        *) ids+=("$1") ;;
        esac
        shift
    done
    if ((${#ids[@]} > 1)); then
        ticket_usage >&2
        return 1
    fi
    if ((wait)) && ! [[ $WS_UP_TIMEOUT =~ ^(0|[1-9][0-9]{0,8})$ ]]; then
        echo "ws: WS_UP_TIMEOUT must be a number of seconds" >&2
        return 1
    fi
    if ! command -v dockyard >/dev/null; then
        echo "ws: dockyard is not installed" >&2
        return 1
    fi
    if ((wait)) && ! command -v curl >/dev/null; then
        echo "ws: --wait needs curl" >&2
        return 1
    fi
    ticket_target "ws up <id>" "${ids[@]}" || return 1
    dir=$REPLY
    if ! ticket_read "$dir" kv; then
        echo "ws: $REPLY" >&2
        return 1
    fi
    id=${kv[WS_ID]} branch=${kv[WS_BRANCH]-}
    if [[ -z $branch ]]; then
        echo "ws: $(ws_shown "$dir/.ws") has no WS_BRANCH" >&2
        return 1
    fi
    real=$(realpath -e -- "$dir") || return 1
    ticket_env env "$real" "$branch" || return 1
    if [[ -n ${env[other]} ]]; then
        echo "ws: dockyard stack ${env[stack]} is registered with ${env[other]}, so ws up starts nothing" >&2
        return 1
    fi
    if [[ -n ${kv[WS_URLS]-} && -n ${env[slot]} && ${kv[WS_SLOT]-} == "${env[slot]}" ]] &&
        ticket_env_running "${env[project]}"; then
        urls=${kv[WS_URLS]}
        echo "The env of $id is already up on slot ${env[slot]}."
        read -r -a pairs <<<"$urls"
        for pair in "${pairs[@]}"; do
            echo "  ${pair%%=*} ${pair#*=}"
        done
    else
        out=$(mktemp) || return 1
        # dockyard handles Ctrl-C itself, so ws waits for it and then records what is left.
        trap : INT
        DOCKYARD_WORKSPACE=$real dockyard up "$branch" </dev/null | tee -i -- "$out" || rc=${PIPESTATUS[0]}
        trap - INT
        ticket_dockyard_out "$out" said
        rm -f -- "$out"
        urls=${said["urls"]}
        ticket_env env "$real" "$branch" || return 1
        if ((rc)); then
            why="dockyard up $branch failed with status $rc"
        elif [[ ${said["stack"]} != "${env[stack]}" ]]; then
            why="dockyard named the stack '${said["stack"]}', not ${env[stack]}"
            rc=1
        elif [[ -z ${env[slot]} ]]; then
            why="dockyard up $branch left no record that names $(ws_shown "$dir") as its workspace"
            rc=1
        elif [[ -z $urls ]]; then
            why="dockyard up $branch printed no URLs"
            rc=1
        elif ! ticket_line WS_URLS "$urls"; then
            why=".ws records slot ${env[slot]} without the URLs"
            rc=1
        fi
        if ((rc)); then
            ticket_update "$dir" set WS_SLOT "${env[slot]}" WS_URLS "" || true
            ticket_claude_refresh "$dir" || true
            echo "ws: $why" >&2
            if [[ -n ${env[other]} ]]; then
                echo "ws: dockyard stack ${env[stack]} is registered with ${env[other]}, so its nuke would remove that env" >&2
            fi
            return "$rc"
        fi
    fi
    ticket_update "$dir" set WS_SLOT "${env[slot]}" WS_URLS "$urls" || return 1
    ticket_claude_refresh "$dir" || echo "ws: cannot write $(ws_shown "$dir/CLAUDE.md")" >&2
    ticket_env_logs "$id" "$dir" "${env[project]}" || echo "ws: cannot tail the logs in the env window of $id" >&2
    ((wait == 0)) || ticket_env_wait "$urls"
}

ws_down() {
    local dir real id branch
    local -A kv=() env=()
    case "$#:${1-}" in
    1:-h | 1:--help)
        ticket_usage
        return 0
        ;;
    0: | 1:*) ;;
    *)
        ticket_usage >&2
        return 1
        ;;
    esac
    ticket_target "ws down <id>" "$@" || return 1
    dir=$REPLY
    if ! ticket_read "$dir" kv; then
        echo "ws: $REPLY" >&2
        return 1
    fi
    id=${kv[WS_ID]} branch=${kv[WS_BRANCH]-}
    real=$(realpath -e -- "$dir") || return 1
    ticket_env env "$real" "$branch" || return 1
    if [[ -n ${env[other]} ]]; then
        echo "ws: dockyard stack ${env[stack]} is registered with ${env[other]}, so ws leaves it" >&2
    fi
    ticket_env_down "$dir" "$branch" "${env[slot]}" "${env[project]}" || return
    if [[ -n ${env[slot]} ]]; then
        echo "The env of $id is down and keeps slot ${env[slot]}."
    else
        echo "$id has no env."
    fi
}

ticket_claude_rows() {
    jq -r --arg d "$1" '.[] | select(type == "object" and (.id | type) == "string" and (.cwd | type) == "string")
        | select(.cwd == $d or (.cwd | startswith($d + "/"))) | select(.state == "working" or .state == "blocked")
        | select(.id | test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) | "\(.id)\t\((.pid | numbers) // "")"' <<<"$2"
}

ws_argv_has() {
    local arg
    local -a args=()
    { mapfile -d '' args <"$WS_PROC/$1/cmdline"; } 2>/dev/null || return 1
    for arg in "${args[@]}"; do
        [[ $arg != "$2" ]] || return 0
    done
    return 1
}

ticket_wait_idle() {
    local k pid why
    for ((k = 0; k < 50; k++)); do
        if ! ws_cwd_count "$1" >"$2"; then
            why=$(<"$2")
            echo "${why:-ws cannot tell which processes work in $(ws_shown "$1")}"
            return 1
        fi
        ((${#WS_CWD_PIDS[@]})) || return 0
        sleep 0.1
    done
    pid=${WS_CWD_PIDS[0]}
    echo "process $pid ($(ws_comm "$pid" || echo '?')) still works in $(ws_shown "$1")"
    return 1
}

ws_rm() {
    local id dir real here d i why agents rows sid pid parent path spath="" ours=0 fail=0 purge=0 rc=0 trash
    local -a wts=() stop=() mine=() repos=()
    local -A kv=() env=()
    if [[ ${1-} == --purge ]]; then
        purge=1
        shift
    fi
    case "$#:${1-}" in
    1:-h | 1:--help)
        ticket_usage
        return 0
        ;;
    1:*) id=$1 ;;
    *)
        ticket_usage >&2
        return 1
        ;;
    esac
    ticket_check_id "$id" || return 1
    dir=$WS_ROOT/$id
    if [[ -L $dir || ! -d $dir || ! -e $dir/.ws ]]; then
        echo "ws: no ticket $(ws_shown "$dir")" >&2
        return 1
    fi
    real=$(realpath -e -- "$dir") || return 1
    here=$(pwd -P)
    if [[ $here == "$real" || $here == "$real"/* ]]; then
        echo "ws: you are in $(ws_shown "$dir"); cd out of it first" >&2
        return 1
    fi
    if [[ -n ${TMUX-} && $(tmux display-message -p '#{session_name}' 2>/dev/null) == "$id" ]]; then
        echo "ws: this is the tmux session of $id; switch to another session first" >&2
        return 1
    fi
    WS_TRASH=$(realpath -m -- "$WS_TRASH") || return 1
    ws_env_ok || return 1
    if ticket_read "$dir" kv; then
        ticket_env env "$real" "${kv[WS_BRANCH]-}" || return 1
        if ((purge)) && [[ -n ${env[other]} ]]; then
            echo "ws: dockyard stack ${env[stack]} is registered with ${env[other]}, so --purge leaves it" >&2
        fi
        if [[ -n ${env[slot]} ]] && ! ticket_env_down "$dir" "${kv[WS_BRANCH]}" "${env[slot]}" "${env[project]}"; then
            echo "ws: kept $id" >&2
            return 1
        fi
    elif ((purge)); then
        echo "ws: $REPLY, so ws cannot tell which env to purge" >&2
        return 1
    fi
    ws_engine_mounts
    d=$(mktemp -d) || return 1
    mapfile -t wts < <(ws_worktrees "$dir")
    for i in "${!wts[@]}"; do
        ws_wt_facts "${wts[i]}" >"$d/$i" 2>/dev/null
        sed 's/^in-use=.*/in-use=0/' "$d/$i" >"$d/$i.pre"
        why=$(ws_keep_why "$d/$i.pre")
        if [[ -n $why ]]; then
            echo "ws: $(ws_shown "${wts[i]}"): ${why#KEEP }" >&2
            fail=1
        fi
    done
    if ((fail)); then
        rm -rf -- "$d"
        echo "ws: kept $id; ws prune -h explains each reason" >&2
        return 1
    fi

    if agents=$(timeout -k 2 10 claude agents --json </dev/null 2>/dev/null) &&
        rows=$(ticket_claude_rows "$real" "$agents" 2>/dev/null); then
        while IFS=$'\t' read -r sid pid; do
            [[ -n $sid ]] || continue
            stop+=("$sid")
            [[ $pid =~ ^[0-9]+$ && $pid != [01] ]] || continue
            path=$(readlink -- "$WS_PROC/$pid/cwd" 2>/dev/null) || continue
            [[ $path == "$real" || $path == "$real"/* ]] || continue
            mine+=("$pid")
            if parent=$(ws_ppid "$pid") && ws_argv_has "$parent" --bg-pty-host; then
                mine+=("$parent")
            fi
        done <<<"$rows"
    else
        echo "ws: claude agents --json failed, so ws stops no background session" >&2
    fi
    WS_TMUX_PIDS=" $(tmux display-message -p '#{pid}' 2>/dev/null || true) "
    if spath=$(ticket_session_path "$id") && [[ $(realpath -m -- "$spath") == "$real" ]]; then
        ours=1
        mapfile -t -O "${#mine[@]}" mine < <(tmux list-panes -s -t "=$id:" -F '#{pane_pid}' 2>/dev/null)
        WS_TMUX_PIDS+="$(tmux list-clients -t "=$id:" -F '#{client_pid}' 2>/dev/null | paste -sd ' ' || true) "
    fi
    if ! ws_cwd_count "$real" "${mine[@]}" >"$d/in-use"; then
        why=$(<"$d/in-use")
        echo "ws: ${why:-ws cannot tell which processes work in $(ws_shown "$dir")}" >&2
        fail=1
    elif ((${#WS_CWD_PIDS[@]})); then
        pid=${WS_CWD_PIDS[0]}
        echo "ws: process $pid ($(ws_comm "$pid" || echo '?')) works in $(ws_shown "$dir")," \
            "outside its tmux session and its Claude sessions" >&2
        fail=1
    fi
    if ((fail)); then
        rm -rf -- "$d"
        echo "ws: kept $id" >&2
        return 1
    fi

    for sid in "${stop[@]}"; do
        if timeout -k 2 30 claude stop "$sid" </dev/null >/dev/null 2>&1; then
            echo "Stopped Claude session $sid"
        else
            echo "ws: claude stop $sid failed" >&2
        fi
    done
    if ((ours)); then
        if tmux kill-session -t "=$id:"; then
            echo "Killed tmux session $id"
        fi
    elif [[ -n $spath ]]; then
        echo "ws: tmux session $id works in $(ws_shown "$spath"), so ws leaves it" >&2
    fi
    if ! why=$(ticket_wait_idle "$dir" "$d/in-use"); then
        rm -rf -- "$d"
        echo "ws: $why, so ws moved nothing" >&2
        return 1
    fi
    WS_SCANNED_REPOS=()
    for i in "${!wts[@]}"; do
        WS_SCANNED_REPOS+=("$(ws_decode "$(ws_fact "$d/$i" common)")")
    done
    ws_engine_mounts
    for i in "${!wts[@]}"; do
        ws_wt_facts "${wts[i]}" >"$d/$i" 2>/dev/null
        why=$(ws_keep_why "$d/$i")
        if [[ -n $why ]]; then
            echo "Kept $(ws_shown "${wts[i]}"): ${why#KEEP }"
            fail=1
        fi
    done
    if ((fail)); then
        rm -rf -- "$d"
        echo "ws: kept $id, so ws moved nothing" >&2
        return 1
    fi
    : "${WS_STAMP:=$(date -u +%Y%m%dT%H%M%SZ)}"
    for i in "${!wts[@]}"; do
        ws_trash_move "${wts[i]}" "$d/$i" pr "" state "" oid "" || fail=1
    done
    rm -rf -- "$d"
    if [[ -z ${WS_TICKET_TRASH[$dir]-} ]] && ((fail == 0)); then
        WS_TICKET_TRASH[$dir]=$(ws_free_path "$WS_TRASH/$WS_STAMP" "-$id")
        mkdir -p -- "${WS_TICKET_TRASH[$dir]}" || return 1
    fi
    if [[ -n ${WS_TICKET_TRASH[$dir]-} ]]; then
        ws_trash_ticket_files "$dir"
    fi
    [[ ! -e $dir ]] || fail=1
    if ((fail)); then
        return 1
    fi
    echo "Removed ticket $id. ws prune --restore $id brings it back."
    ((purge)) && [[ -n ${env[slot]-} ]] || return 0
    ticket_env env "$real" "${kv[WS_BRANCH]}" || return 1
    if [[ -z ${env[slot]} ]]; then
        echo "ws: the record of dockyard stack ${env[stack]} no longer names $(ws_shown "$dir"), so ws purges nothing" >&2
        return 1
    fi
    dockyard nuke "${kv[WS_BRANCH]}" </dev/null || rc=$?
    if ((rc)); then
        echo "ws: dockyard nuke ${kv[WS_BRANCH]} failed with status $rc, so the env's volumes and slot stay" >&2
        return "$rc"
    fi
    trash=${WS_TICKET_TRASH[$dir]}
    if ! ticket_read "$trash" kv "$id"; then
        echo "ws: $REPLY, so ws cannot clear its slot" >&2
        return 1
    fi
    kv[WS_SLOT]="" kv[WS_URLS]=""
    if ! ticket_write "$trash" kv; then
        echo "ws: cannot clear the slot in $(ws_shown "$trash/.ws")" >&2
        return 1
    fi
    read -r -a repos <<<"${kv[WS_REPOS]-}"
    ticket_claude_md "$trash" "$id" "${kv[WS_BRANCH]-}" "${kv[WS_REPOS]-}" "${repos[@]}" ||
        echo "ws: cannot write $(ws_shown "$trash/CLAUDE.md")" >&2
}

scenario_ids() {
    sed -n 's/^## \(S[0-9][0-9]*\)\. .*/\1/p' "$1"
}

scenarios_prompt() {
    local key=$1 from=$2 tool=$3
    echo "You write the holdout acceptance scenarios of ticket $key. A separate Claude session builds the ticket and cannot edit these scenarios. Later a tester session runs each scenario in a browser and with HTTP calls against the running app, and marks it PASS or FAIL."
    echo
    if [[ -n $from ]]; then
        echo "The ticket text follows the line TICKET TEXT at the end."
    else
        echo "Read the Jira issue $key with the tool $tool. If you cannot read it, print exactly \"ws: cannot read $key\" and nothing else."
    fi
    echo
    echo "Print only the scenarios in Markdown, with nothing before or after them. Write 3 to 8 scenarios. Start each one with a heading line \"## S<n>. <title>\", numbered from S1 with no gaps. Under the heading, write a Given line, a When line, and a Then line that a tester can check in the UI or with an HTTP call. Cover the main flow, each edge case that the ticket names, and one check that nearby behavior still works. Add no requirement that the ticket does not state."
    if [[ -n $from ]]; then
        echo
        echo "TICKET TEXT"
        cat -- "$from"
    fi
}

ws_scenarios() {
    local from="" replace=0 tool="" dir id key file out result body tmp sum src rc=0 i
    local -a ids=() args=() heads=()
    local -A kv=()
    while (($#)); do
        case $1 in
        --from)
            if (($# < 2)); then
                ticket_usage >&2
                return 1
            fi
            from=$2
            shift
            ;;
        --replace) replace=1 ;;
        -h | --help)
            ticket_usage
            return 0
            ;;
        -*)
            ticket_usage >&2
            return 1
            ;;
        *) ids+=("$1") ;;
        esac
        shift
    done
    if ((${#ids[@]} > 1)); then
        ticket_usage >&2
        return 1
    fi
    ticket_target "ws scenarios <id>" "${ids[@]}" || return 1
    dir=$REPLY
    if ! ticket_read "$dir" kv; then
        echo "ws: $REPLY" >&2
        return 1
    fi
    id=${kv[WS_ID]} key=${kv[WS_TICKET]:-${kv[WS_ID]}}
    file=$(ticket_scenarios_file kv)
    if [[ ! -d $WS_VAULT ]]; then
        echo "ws: the vault $(ws_shown "$WS_VAULT") is not a directory" >&2
        return 1
    fi
    if [[ -n ${CLAUDECODE-} && (-e $file || -L $file) ]] && ((replace == 0)); then
        echo "ws: $id has scenarios, and CLAUDECODE says this runs inside a Claude session; pass --replace to replace them" >&2
        return 1
    fi
    if [[ -n $from ]]; then
        if ! from=$(realpath -e -- "$from" 2>/dev/null) || [[ ! -f $from || ! -r $from ]] ||
            ! grep -q '[^[:space:]]' -- "$from"; then
            echo "ws: --from takes a readable file that holds the ticket text" >&2
            return 1
        fi
        if (($(wc -c <"$from") > 262144)); then
            echo "ws: $(ws_shown "$from") is over 256 KB" >&2
            return 1
        fi
        args=(--strict-mcp-config)
        src="the ticket text in $(ws_shown "$from")"
    elif [[ -z ${kv[WS_TICKET]-} ]]; then
        echo "ws: $id has no WS_TICKET, so ws cannot ask Jira for it; pass --from <file> with the ticket text" >&2
        return 1
    elif [[ ! $WS_JIRA_MCP =~ ^[A-Za-z0-9_-]+$ || ! $WS_JIRA_TOOL =~ ^[A-Za-z0-9_-]+$ ]]; then
        echo "ws: WS_JIRA_MCP and WS_JIRA_TOOL take ASCII letters, digits, dashes, and underscores" >&2
        return 1
    else
        tool=mcp__${WS_JIRA_MCP}__$WS_JIRA_TOOL
        args=(--allowedTools "$tool")
        src="the Jira issue $key"
    fi
    out=$(scenarios_prompt "$key" "$from" "$tool" | (cd -- "$WS_VAULT" &&
        timeout -k 10 600 claude -p --output-format json --tools '' "${args[@]}")) || rc=$?
    if ((rc)); then
        echo "ws: claude -p failed with status $rc, so $id has no new scenarios" >&2
        return 1
    fi
    if ! result=$(jq -er 'select(.is_error != true) | .result | strings' <<<"$out" 2>/dev/null); then
        echo "ws: claude -p gave no result, so $id has no new scenarios" >&2
        return 1
    fi
    body=$(awk 'f || /^## S1\. / { f = 1; print }' <<<"$result")
    while [[ $body == *$'\n```' ]]; do
        body=${body%$'\n```'}
    done
    mapfile -t heads < <(sed -n 's/^## S\([0-9][0-9]*\)\. .*/\1/p' <<<"$body")
    for i in "${!heads[@]}"; do
        [[ ${heads[i]} == "$((i + 1))" ]] || heads=()
    done
    if ((${#heads[@]} == 0)); then
        echo "ws: claude wrote no scenarios headed ## S1. to ## S<n>. in order, so $id has no new scenarios. It wrote:" >&2
        head -n 5 <<<"$result" >&2
        return 1
    fi
    mkdir -p -- "${file%/*}" || return 1
    tmp=$(mktemp -- "${file%/*}/.$id.md.XXXXXX") || return 1
    if ! {
        printf '# Scenarios for %s\n\nws scenarios wrote this file on %s from %s. ws verify refuses to run once anything else changes it.\n\n%s\n' \
            "$id" "$(date +%F)" "$src" "$body" >"$tmp" &&
            mv -T -- "$tmp" "$file"
    }; then
        rm -f -- "$tmp"
        return 1
    fi
    sum=$(sha256sum <"$file") || return 1
    ticket_update "$dir" set WS_SCENARIOS_SHA256 "${sum%% *}" || return 1
    echo "Wrote ${#heads[@]} scenarios to $(ws_shown "$file")"
}

verify_hash_ok() {
    local sum
    [[ -f $1 && ! -L $1 ]] && sum=$(sha256sum <"$1") && [[ ${sum%% *} == "$2" ]]
}

verify_complete() {
    local file=$1 s
    shift
    [[ -f $file ]] || return 1
    for s; do
        grep -Eq "^RESULT[[:space:]]+${s}[[:space:]]+(PASS|FAIL)([[:space:]]|$)" -- "$file" || return 1
    done
}

# A scenario passes only when it has exactly one RESULT line and that line is PASS, so a second verdict or a
# quoted example line for it reads as FAIL.
verify_verdicts() {
    local file=$1 line s n why
    local -A count=() last=()
    shift
    while IFS= read -r line; do
        [[ $line =~ ^RESULT[[:space:]]+(S[0-9]+)([[:space:]]|$) ]] || continue
        s=${BASH_REMATCH[1]}
        count[$s]=$((${count[$s]-0} + 1))
        last[$s]=$line
    done <"$file"
    for s; do
        n=${count[$s]-0} line=${last[$s]-}
        if ((n == 0)); then
            echo "$s FAIL has no RESULT line"
        elif ((n > 1)); then
            echo "$s FAIL has $n RESULT lines"
        elif [[ $line =~ ^RESULT[[:space:]]+${s}[[:space:]]+PASS[[:space:]]*$ ]]; then
            echo "$s PASS"
        elif [[ $line =~ ^RESULT[[:space:]]+${s}[[:space:]]+FAIL([[:space:]]+(.*))?$ ]]; then
            why=${BASH_REMATCH[2]//[[:cntrl:]]/}
            echo "$s FAIL${why:+ $why}"
        else
            echo "$s FAIL has a RESULT line that is neither PASS nor FAIL"
        fi
    done
}

verify_rows() {
    timeout -k 2 10 claude agents --json </dev/null 2>/dev/null |
        jq -r '.[]? | select(type == "object" and (.cwd | type) == "string" and (.cwd | test("[\t\n]") | not))
            | "\(.cwd)\t\(.id // "")\t\(.state // "")\t\(.status // "")"' 2>/dev/null
}

verify_running() {
    local cwd sid state status
    while IFS=$'\t' read -r cwd sid state status; do
        [[ $cwd == "$1"/* && ${cwd#"$1"/} != */* ]] || continue
        [[ $status == busy || $state == blocked ]] || continue
        printf '%s\n' "$cwd"
        return 0
    done < <(verify_rows)
    return 1
}

# The row of a background session can say idle before its first turn starts, so an idle row counts as done
# only after ws saw the session busy or after a minute.
verify_wait() {
    local ev=$1 start now cwd sid state status busy=0 told=0 found
    shift
    printf -v start '%(%s)T' -1
    VERIFY_SID=
    while :; do
        verify_complete "$ev/results.md" "$@" && return 0
        found=0
        while IFS=$'\t' read -r cwd sid state status; do
            [[ $cwd == "$ev" ]] || continue
            found=1
            VERIFY_SID=$sid
            break
        done < <(verify_rows)
        printf -v now '%(%s)T' -1
        if ((found)) && [[ $status == busy ]]; then
            busy=1
        elif ((found)) && [[ $state == blocked ]]; then
            ((told)) || echo "The verify session waits on you. claude attach $VERIFY_SID shows what it asks."
            told=1
        elif ((busy || now - start >= 60)) && { ((found == 0)) || [[ $status == idle || $state == stopped ]]; }; then
            return 0
        fi
        if ((now - start >= 10#$WS_VERIFY_TIMEOUT)); then
            return 1
        fi
        sleep "$WS_VERIFY_POLL"
    done
}

verify_prompt() {
    local id=$1 file=$2 calib=$3 ev=$4 urls=$5 pair
    local -a pairs=()
    read -r -a pairs <<<"$urls"
    echo "Run the holdout scenarios of ticket $id against its running env, then record the result of each one."
    echo
    echo "- Read the scenarios in $file. Never change that file."
    [[ -z $calib ]] || echo "- Read $calib before you start. It says what QA found that developer tests missed."
    echo "- The env runs at these URLs:"
    for pair in "${pairs[@]}"; do
        echo "  - ${pair%%=*}: ${pair#*=}"
    done
    echo "- Work in $ev. Take one screenshot per scenario and name it after the scenario: S1.png, S2.png, and so on."
    echo
    echo "When every scenario has run, write $ev/results.md. For each scenario, write what you did and what you saw. End the file with one line per scenario in this form:"
    echo
    echo "RESULT S1 PASS"
    echo "RESULT S2 FAIL <what the Then line expected and what happened>"
    echo
    echo "Write PASS only when you saw what the Then line says. A scenario that you could not run is a FAIL."
}

ws_verify() {
    local dir id file want root ev prior calib s verdict why pass=0 rc=0
    local -a ids=() scen=() allow=() deny=() failed=()
    local -A kv=()
    case "$#:${1-}" in
    1:-h | 1:--help)
        ticket_usage
        return 0
        ;;
    0: | 1:[!-]*) ids=("$@") ;;
    *)
        ticket_usage >&2
        return 1
        ;;
    esac
    if ! command -v claude >/dev/null; then
        echo "ws: claude is not installed" >&2
        return 1
    fi
    ticket_target "ws verify <id>" "${ids[@]}" || return 1
    dir=$REPLY
    if ! ticket_read "$dir" kv; then
        echo "ws: $REPLY" >&2
        return 1
    fi
    id=${kv[WS_ID]} want=${kv[WS_SCENARIOS_SHA256]-}
    file=$(ticket_scenarios_file kv)
    if [[ -z $want ]]; then
        echo "ws: $id has no scenarios; run ws scenarios $id first" >&2
        return 1
    fi
    if ! verify_hash_ok "$file" "$want"; then
        echo "ws: scenarios changed since intake" >&2
        return 1
    fi
    mapfile -t scen < <(scenario_ids "$file")
    if ((${#scen[@]} == 0)); then
        echo "ws: $(ws_shown "$file") holds no scenario headed ## S1." >&2
        return 1
    fi
    if [[ -z ${kv[WS_URLS]-} ]] || ! ticket_env_running "dockyard-$(ticket_stack_name "${kv[WS_BRANCH]-}")"; then
        echo "ws: the env of $id is down; run ws up $id first" >&2
        return 1
    fi
    edit_deny_rules deny "$file" "$dir/.ws" "$dir/**" || return 1
    root=$(ticket_evidence_root kv)
    mkdir -p -- "$root" && root=$(realpath -e -- "$root") || return 1
    prior=${kv[WS_STAGE]-}
    [[ $prior != verifying ]] || prior=building
    if ev=$(verify_running "$root"); then
        echo "A verify session of $id already runs in $(ws_shown "$ev"), so ws waits for it."
    else
        ev=$(ws_free_path "$root/$(date +%F)")
        mkdir -- "$ev" || return 1
        calib=$WS_VAULT/global/patterns/qa-calibration.md
        allow=("Read(/$(realpath -m -- "$file"))" mcp__playwright)
        if [[ -f $calib ]]; then
            calib=$(realpath -e -- "$calib")
            allow+=("Read(/$calib)")
        else
            calib=
        fi
        ticket_update "$dir" set WS_STAGE verifying || return 1
        if ! (cd -- "$ev" && claude --bg -n "$id-verify" --agent ui-tester --permission-mode acceptEdits \
            --allowedTools "${allow[@]}" --disallowedTools "${deny[@]}" -- "$(verify_prompt "$id" "$file" "$calib" "$ev" "${kv[WS_URLS]}")" </dev/null); then
            ticket_update "$dir" set WS_STAGE "$prior" || true
            echo "ws: claude --bg failed, so nothing verifies $id" >&2
            return 1
        fi
    fi
    echo "Waiting for $(ws_shown "$ev/results.md"), at most $WS_VERIFY_TIMEOUT seconds."
    if ! verify_wait "$ev" "${scen[@]}"; then
        echo "ws: the verify session wrote no result for every scenario in $WS_VERIFY_TIMEOUT seconds; ws verify $id waits for it again" >&2
        return 1
    fi
    if [[ -n $VERIFY_SID ]] && ! timeout -k 2 30 claude stop "$VERIFY_SID" </dev/null >/dev/null 2>&1; then
        echo "ws: claude stop $VERIFY_SID failed" >&2
    fi
    if ! verify_hash_ok "$file" "$want"; then
        ticket_update "$dir" set WS_STAGE building || true
        echo "ws: scenarios changed since intake" >&2
        return 1
    fi
    if [[ ! -f $ev/results.md ]]; then
        ticket_update "$dir" set WS_STAGE "$prior" || true
        echo "ws: the verify session ended without $(ws_shown "$ev/results.md")" >&2
        return 1
    fi
    while read -r s verdict why; do
        if [[ $verdict == PASS ]]; then
            pass=$((pass + 1))
        else
            failed+=("$s${why:+ $why}")
        fi
    done < <(verify_verdicts "$ev/results.md" "${scen[@]}")
    if ((pass == ${#scen[@]})); then
        ticket_update "$dir" set WS_STAGE qa || rc=1
    else
        ticket_update "$dir" set WS_STAGE building || true
        rc=1
    fi
    echo "$pass/${#scen[@]} scenarios passed, evidence at $(ws_shown "$ev")"
    for s in "${failed[@]}"; do
        echo "  FAIL $s"
    done
    return "$rc"
}

ws_done() {
    local dir id consolidate rc=0
    local -A kv=()
    case "$#:${1-}" in
    1:-h | 1:--help)
        ticket_usage
        return 0
        ;;
    0: | 1:[!-]*) ;;
    *)
        ticket_usage >&2
        return 1
        ;;
    esac
    ticket_target "ws done <id>" "$@" || return 1
    dir=$REPLY
    if ! ticket_read "$dir" kv; then
        echo "ws: $REPLY" >&2
        return 1
    fi
    id=${kv[WS_ID]}
    ticket_update "$dir" set WS_STAGE merged || return 1
    echo "$id is at merged"
    consolidate=$WS_VAULT/bin/vault-consolidate
    if [[ ! -x $consolidate ]]; then
        echo "ws: $(ws_shown "$consolidate") is not an executable file, so ws consolidates nothing" >&2
        rc=1
    elif ! WS_VAULT=$WS_VAULT WS_ROOT=$WS_ROOT "$consolidate" </dev/null; then
        echo "ws: vault-consolidate failed" >&2
        rc=1
    fi
    if ((rc)); then
        echo "ws keeps $id, because vault-consolidate archives the learnings of a merged ticket only while its .ws is in $(ws_shown "$WS_ROOT"). Run ws done $id again once vault-consolidate works." >&2
        return 1
    fi
    if [[ -t 0 && -t 1 ]] && ws_confirm "Move the worktrees and files of $id to the trash with ws rm $id?"; then
        ws_rm "$id" || return 1
    else
        echo "ws rm $id moves its worktrees and files to the trash."
    fi
}

main() {
    local cmd=${1:-}
    if [[ $cmd == -h || $cmd == --help ]]; then
        usage
        return 0
    fi
    if [[ -z $cmd || -z ${WS_COMMANDS[$cmd]+set} ]]; then
        usage >&2
        return 1
    fi
    shift
    "ws_$cmd" "$@"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    set -euo pipefail
    main "$@"
fi
